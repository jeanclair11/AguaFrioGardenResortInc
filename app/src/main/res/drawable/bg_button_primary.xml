<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/rippleAccent">
    <item>
        <selector>
            <!-- Disabled State -->
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/buttonDisabledColor" />
                    <corners android:radius="14dp" />
                </shape>
            </item>

            <!-- Enabled State (Default): each theme supplies its own gradient -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="?attr/buttonGradientStart"
                        android:endColor="?attr/buttonGradientEnd"
                        android:type="linear" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
