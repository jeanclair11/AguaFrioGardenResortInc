<?xml version="1.0" encoding="utf-8"?>
<!-- "Who is this booking for?" option row, unselected state. The controller
     swaps in bg_selectable_card_selected while a card's radio is checked. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fieldBackground" />
    <stroke android:width="1dp" android:color="?attr/fieldStroke" />
    <corners android:radius="12dp" />
</shape>
