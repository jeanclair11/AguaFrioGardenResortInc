<?xml version="1.0" encoding="utf-8"?>
<!-- Alerts tab card for an unread notification: accent-tinted, accent border, and a solid accent
     stripe down the left edge so it stands out from the flat grey read cards. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/accentPrimary" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="5dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/notificationUnreadFill" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/accentPrimary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
