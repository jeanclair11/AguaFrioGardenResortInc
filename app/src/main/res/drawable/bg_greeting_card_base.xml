<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque base for the greeting banner (full-width rectangular hero section);
     always fully covered by the time-of-day photo drawn above it. Corners set
     to 0dp for rectangular (non-card) appearance. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/white" />
    <corners android:radius="0dp" />
</shape>
