<?xml version="1.0" encoding="utf-8"?>
<!-- Circular avatar frame on the dashboard top bar; the translucent white
     chip reads well on every theme's bar color. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#33FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#80FFFFFF" />
</shape>
