<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass tint over the greeting card's background photo: a
     semi-transparent white fill plus a thin white border. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_overlay_fill" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_overlay_border" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
