<?xml version="1.0" encoding="utf-8"?>
<!-- Alerts tab card for a notification the guest has read: tinted (not the screen's own white in
     Light Mode, which made cards look plain) with a hairline border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/chatBubbleOther" />
    <stroke
        android:width="1dp"
        android:color="?attr/dividerColor" />
    <corners android:radius="18dp" />
</shape>
