    <!-- Dark theme: the original night-navy palette, paired with a Sunset
         Orange accent used consistently across the interface. -->
    <color name="dark_gradient_start">#0A121E</color>
    <color name="dark_gradient_end">#16233A</color>
    <!-- A lighter shade of the gradient (not darker, at any scroll
         position) so cards read as a gentle, harmonious lift off the
         background instead of a harsh dark block. -->
    <color name="dark_card">#182640</color>
    <color name="dark_raised">#20304C</color>
