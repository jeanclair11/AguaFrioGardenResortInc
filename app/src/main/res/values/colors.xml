<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand constants (same in every theme) -->
    <color name="header_overlay_dark">#D90A121E</color>
    <color name="header_overlay_mid">#990E1828</color>
    <color name="header_overlay_light">#4D0A121E</color>

    <!-- Warm, low-opacity shadow tint (API 28+) so elevated cards cast a
         soft diffused shadow that blends with the beige background instead
         of a harsh black one. Ambient is fainter than spot. -->
    <color name="card_shadow_ambient">#1A3A2E1E</color>
    <color name="card_shadow_spot">#2E3A2E1E</color>

    <!-- Greeting card glass overlay: the card shows a time-of-day photo
         (see DashboardActivity$GreetingPeriod) under a frosted glass tint,
         so its palette is fixed white/translucent regardless of the app's
         Light/Dark theme. -->
    <color name="glass_overlay_fill">#4DFFFFFF</color>
    <color name="glass_overlay_border">#66FFFFFF</color>
    <color name="glass_icon_chip">#4DFFFFFF</color>
    <color name="glass_divider">#40FFFFFF</color>
    <color name="glass_text_primary">#FFFFFFFF</color>
    <color name="glass_text_secondary">#D9FFFFFF</color>
    <color name="glass_text_welcome">#E6FFFFFF</color>
    <!-- Sits between the photo and the frosted glass tint so bright sky
         areas don't wash out the text; kept within 20-30% so the scenery
         still reads through. -->
    <color name="glass_black_overlay">#4D000000</color>

    <!-- Booking catalog tile tints: fixed per category (same in both themes),
         used as the image placeholder behind each category's icon until real
         photography is wired up via the backend. -->
    <color name="catalog_tile_hotel">#6E5240</color>
    <color name="catalog_tile_ktv">#453368</color>
    <color name="catalog_tile_halls">#3E4A5C</color>
    <color name="catalog_tile_pool">#2E6E7A</color>

    <!-- Light theme: the warm cream/ivory palette with Royal Blue reserved
         for primary buttons and interactive accents. -->
    <color name="light_gradient_start">#F8F2E6</color>
    <color name="light_gradient_end">#EFE4CD</color>
    <color name="light_card">#FCF8EF</color>
    <color name="light_raised">#EFE6D3</color>
