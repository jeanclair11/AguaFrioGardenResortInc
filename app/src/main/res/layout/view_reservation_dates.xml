<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation Module, screen 1: reservation dates and party size. This is
     the Reserve tab's root screen (no back header). See
     ReservationFlowController#bindDates. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reservation_dates_title"
                android:textColor="?attr/textOnScreen"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/reservation_dates_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/reservationMyListLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="@string/link_view_my_reservations"
                android:textColor="?attr/accentPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="18dp"
                android:text="@string/label_check_in" />

            <LinearLayout style="@style/InputField">
                <ImageView style="@style/InputIcon" android:src="@drawable/ic_calendar" />
                <EditText
                    android:id="@+id/reservationCheckInField"
                    style="@style/InputEditText"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_select_date" />
            </LinearLayout>
            <TextView android:id="@+id/reservationCheckInError" style="@style/FieldError" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_check_out" />

            <LinearLayout style="@style/InputField">
                <ImageView style="@style/InputIcon" android:src="@drawable/ic_calendar" />
                <EditText
                    android:id="@+id/reservationCheckOutField"
                    style="@style/InputEditText"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_select_date" />
            </LinearLayout>
            <TextView android:id="@+id/reservationCheckOutError" style="@style/FieldError" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_adults" />

            <LinearLayout style="@style/InputField" android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/reservationAdultsMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/bg_stepper_button" />

                <TextView
                    android:id="@+id/reservationAdultsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/reservationAdultsPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/bg_stepper_button" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_children" />

            <LinearLayout style="@style/InputField" android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/reservationChildrenMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/bg_stepper_button" />

                <TextView
                    android:id="@+id/reservationChildrenValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/reservationChildrenPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/bg_stepper_button" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/reservationDatesNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />
    </LinearLayout>

</LinearLayout>
