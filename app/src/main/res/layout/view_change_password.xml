<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <include
            android:id="@+id/headerBar"
            layout="@layout/view_screen_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shield"
                android:tint="?attr/accentPrimary"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change_password_notice_title"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/change_password_notice_message"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_current_password" />

        <LinearLayout style="@style/InputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_lock" />
            <EditText
                android:id="@+id/cpCurrentPasswordField"
                style="@style/InputEditText"
                android:hint="@string/hint_current_password"
                android:inputType="textPassword" />
            <ImageView
                android:id="@+id/cpCurrentToggle"
                style="@style/InputTrailingIcon"
                android:src="@drawable/ic_eye"
                android:tint="?attr/iconMuted" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="4dp"
            android:text="@string/helper_current_password"
            android:textColor="?attr/textOnScreenMuted"
            android:textSize="12sp" />
        <TextView android:id="@+id/cpCurrentError" style="@style/FieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_new_password" />

        <LinearLayout style="@style/InputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_lock" />
            <EditText
                android:id="@+id/cpNewPasswordField"
                style="@style/InputEditText"
                android:hint="@string/hint_new_password"
                android:inputType="textPassword" />
            <ImageView
                android:id="@+id/cpNewToggle"
                style="@style/InputTrailingIcon"
                android:src="@drawable/ic_eye"
                android:tint="?attr/iconMuted" />
        </LinearLayout>
        <TextView
            android:id="@+id/cpStrengthText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView android:id="@+id/cpNewError" style="@style/FieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_confirm_new_password" />

        <LinearLayout style="@style/InputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_lock" />
            <EditText
                android:id="@+id/cpConfirmPasswordField"
                style="@style/InputEditText"
                android:hint="@string/hint_confirm_new_password"
                android:inputType="textPassword" />
            <ImageView
                android:id="@+id/cpConfirmToggle"
                style="@style/InputTrailingIcon"
                android:src="@drawable/ic_eye"
                android:tint="?attr/iconMuted" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="4dp"
            android:text="@string/helper_confirm_new_password"
            android:textColor="?attr/textOnScreenMuted"
            android:textSize="12sp" />
        <TextView android:id="@+id/cpConfirmError" style="@style/FieldError" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/password_requirements_title"
                android:textColor="?attr/accentPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cpReqLengthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/cpReqLengthIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check_circle"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/cpReqLengthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/requirement_length"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cpReqCaseRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/cpReqCaseIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check_circle"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/cpReqCaseText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/requirement_case"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cpReqNumberRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/cpReqNumberIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check_circle"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/cpReqNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/requirement_number"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cpReqSpecialRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/cpReqSpecialIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check_circle"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/cpReqSpecialText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/requirement_special"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/cpUpdateButton"
            style="@style/PrimaryButton"
            android:layout_marginTop="24dp"
            android:text="@string/button_update_password" />

        <Button
            android:id="@+id/cpCancelButton"
            style="@style/SecondaryButton"
            android:layout_marginTop="10dp"
            android:text="@string/button_cancel" />

    </LinearLayout>
</ScrollView>
