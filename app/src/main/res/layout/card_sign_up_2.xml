<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up step 2: account credentials. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/signup_heading"
        android:textColor="?attr/textPrimary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/signup_step2_subheading"
        android:textColor="?attr/textMuted"
        android:textSize="13sp" />

    <!-- Username -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="22dp"
        android:text="@string/label_username" />

    <LinearLayout style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_person" />

        <EditText
            android:id="@+id/usernameField"
            style="@style/InputEditText"
            android:hint="@string/hint_username"
            android:inputType="text" />
    </LinearLayout>

    <TextView
        android:id="@+id/usernameError"
        style="@style/FieldError" />

    <!-- Email -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_email" />

    <LinearLayout style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_email" />

        <EditText
            android:id="@+id/emailField"
            style="@style/InputEditText"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress" />
    </LinearLayout>

    <TextView
        android:id="@+id/emailError"
        style="@style/FieldError" />

    <!-- Password -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_create_password" />

    <LinearLayout style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_lock" />

        <EditText
            android:id="@+id/passwordField"
            style="@style/InputEditText"
            android:hint="@string/hint_create_password"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/passwordToggle"
            style="@style/InputTrailingIcon"
            android:src="@drawable/ic_eye" />
    </LinearLayout>

    <TextView
        android:id="@+id/passwordStrengthText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/passwordError"
        style="@style/FieldError" />

    <!-- Confirm Password -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_confirm_password" />

    <LinearLayout style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_lock" />

        <EditText
            android:id="@+id/confirmPasswordField"
            style="@style/InputEditText"
            android:hint="@string/hint_confirm_password"
            android:inputType="textPassword" />
    </LinearLayout>

    <TextView
        android:id="@+id/confirmPasswordError"
        style="@style/FieldError" />

    <!-- Back / Proceed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/signUp2BackButton"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/button_back" />

        <Button
            android:id="@+id/signUp2ProceedButton"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/button_proceed" />
    </LinearLayout>
</LinearLayout>
