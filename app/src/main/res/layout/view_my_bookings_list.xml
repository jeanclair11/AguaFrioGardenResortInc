<?xml version="1.0" encoding="utf-8"?>
<!-- Book tab: booking history with a Current/Past filter. Booking-flavored
     twin of view_reservation_my_list.xml. See
     HotelBookingFlowController#bindMyBookingsList. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <include
            android:id="@+id/myBookingsHeaderBar"
            layout="@layout/view_screen_header" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/tabCurrentBookings" style="@style/ChatChip" android:text="@string/tab_current_bookings" />
            <TextView android:id="@+id/tabPastBookings" style="@style/ChatChip" android:text="@string/tab_past_bookings" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/myBookingsListEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/booking_list_empty"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/myBookingsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
