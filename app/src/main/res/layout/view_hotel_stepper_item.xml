<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable room/amenity/food card with a quantity stepper; reused by
     the Hotel Rooms, Choose Amenity and Order Food screens
     (see HotelBookingFlowController). Fields not relevant to a given screen
     (category tag, meta line, description) are hidden in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_item_thumb"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/stepperItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stepperItemCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="?attr/accentPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/stepperItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stepperItemDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="?attr/textMuted"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/stepperItemMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/textMuted"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/stepperItemPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/accentPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Cottage/KTV cards only: the live available_quantity from the Admin Web catalog. -->
            <TextView
                android:id="@+id/stepperItemAvailableUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/textMuted"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?attr/dividerColor" />

    <LinearLayout
        android:id="@+id/stepperItemQuantityRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_quantity"
            android:textColor="?attr/textMuted"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/stepperItemMinus"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/ic_minus"
            android:background="@drawable/bg_stepper_button" />

        <EditText
            android:id="@+id/stepperItemQtyValue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="?attr/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@null"
            android:padding="0dp"
            android:minHeight="0dp"
            android:inputType="number"
            android:maxLength="3"
            android:selectAllOnFocus="true"
            android:imeOptions="actionDone"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/stepperItemPlus"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/ic_plus"
            android:background="@drawable/bg_stepper_button" />

    </LinearLayout>

    <!-- Optional per-card proceed action. Gone by default (Amenity/Food screens rely on their
         own bottom Next/Skip buttons instead); only the Reservation Module's results list shows
         and wires this, enabled once this card's quantity is > 0. -->
    <Button
        android:id="@+id/stepperItemReserveButton"
        style="@style/PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:minHeight="0dp"
        android:text="@string/button_reserve"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- KTV cards only: a single select/selected toggle, replacing the quantity stepper and
         Reserve button above (a KTV room is a single mutually-exclusive pick, not a quantity). -->
    <Button
        android:id="@+id/stepperItemSelectButton"
        style="@style/SecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:minHeight="0dp"
        android:text="@string/button_select"
        android:textColor="?attr/textPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
