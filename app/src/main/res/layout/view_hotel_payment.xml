<?xml version="1.0" encoding="utf-8"?>
<!-- Hotel booking flow, screen 7: GCash payment mock-up and proof-of-payment
     upload. See HotelBookingFlowController#bindPayment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/hotelPaymentHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:id="@+id/hotelPaymentSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="18dp"
                android:text="@string/hotel_payment_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <!-- Amount Due -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_amount_due" />

                <TextView
                    android:id="@+id/paymentAmountDue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/textPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Reservation Payment only (see HotelBookingFlowController#bindReservationPayment)
                     — shows both the full amount and the 30% down payment instead of the single
                     paymentAmountDue figure above, which stays GONE in that context. -->
                <include
                    android:id="@+id/paymentAmountDueFullRow"
                    layout="@layout/view_hotel_label_value_row"
                    android:visibility="gone" />

                <include
                    android:id="@+id/paymentAmountDueDownRow"
                    layout="@layout/view_hotel_label_value_row"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Scan to Pay via GCash -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_scan_to_pay" />

                <FrameLayout
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_marginTop="14dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_qr_container"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gcash_qr_personal"
                        android:contentDescription="@string/section_scan_to_pay" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/gcash_account_name"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/gcash_account_number"
                    android:textColor="?attr/textMuted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/gcash_qr_hint"
                    android:textColor="?attr/textMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Submit Payment Details -->
            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.04"
                android:textAllCaps="true"
                android:textColor="?attr/textOnScreen"
                android:text="@string/section_submit_payment_details" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="14dp"
                android:text="@string/label_amount_paid" />

            <LinearLayout style="@style/InputField">
                <EditText
                    android:id="@+id/paymentAmountPaidField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_amount_paid"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_reference_number" />

            <LinearLayout style="@style/InputField">
                <EditText
                    android:id="@+id/paymentReferenceField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_reference_number"
                    android:inputType="number" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="20dp"
                android:text="@string/section_payment_screenshot" />

            <FrameLayout
                android:id="@+id/paymentScreenshotDropzone"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_upload_dropzone"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/paymentScreenshotHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_upload"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/upload_payment_screenshot"
                        android:textColor="?attr/textMuted"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/paymentScreenshotPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/helper_payment_screenshot"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/hotelPaymentCompleteButton"
            style="@style/PrimaryButton"
            android:text="@string/button_complete_booking" />
    </LinearLayout>

</LinearLayout>
