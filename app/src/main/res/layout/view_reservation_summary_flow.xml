<?xml version="1.0" encoding="utf-8"?>
<!-- Reserve flow's own Summary screen (Hotel Room/Cottage/KTV — see
     HotelBookingFlowController#bindReservationSummary), reached from Order Food instead of the
     Book flow's Billing Summary. Guest Information through Amount to Pay reuse Billing Summary's
     exact card styling (BillingSectionLabel headers, view_hotel_billing_line_row.xml line items)
     for visual consistency between the two flows; Amount to Pay itself is Reserve-specific
     (Full Payment/30% Down Payment shown as plain informational rows, not the clickable
     Payment Option cards Billing has, since Reserve has no Payment step to choose toward), and
     the Important Notice + policy checkboxes below it are unique to the Reserve flow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/reservationSummaryHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="18dp"
                android:text="@string/hotel_billing_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <!-- Guest Information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_guest_information" />

                <include android:id="@+id/reservationSummaryRowFullName" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationSummaryRowEmail" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationSummaryRowMobile" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationSummaryRowAddress" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Stay/Visit Details — title and which of the 5 rows are shown depend on category
                 (see bindReservationSummary): Hotel uses check-in/out/nights/guests; Cottage uses
                 rate type/date/time/guests; KTV uses rate type/date/start time/end time/guests. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/reservationSummaryDetailsTitle"
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_stay_details" />

                <include android:id="@+id/reservationSummaryDetailsRow1" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationSummaryDetailsRow2" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationSummaryDetailsRow3" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationSummaryDetailsRow4" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationSummaryDetailsRow5" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Selected Room(s)/Cottage/KTV Room — title and line items depend on category. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/reservationSummarySelectedTitle"
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_selected_rooms" />

                <LinearLayout
                    android:id="@+id/reservationSummaryItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Amenities (only shown when at least one is selected) -->
            <LinearLayout
                android:id="@+id/reservationSummaryAmenitiesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_amenities" />

                <LinearLayout
                    android:id="@+id/reservationSummaryAmenitiesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Food Orders (only shown when at least one is selected) -->
            <LinearLayout
                android:id="@+id/reservationSummaryFoodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_food_orders" />

                <LinearLayout
                    android:id="@+id/reservationSummaryFoodContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Amount to Pay (Billing Summary's equivalent "Payment Summary" section, renamed)
                 — Full Payment / 30% Down Payment shown as plain informational rows, not
                 clickable, since Reserve has no payment option to select. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/reservation_summary_amount_to_pay" />

                <include android:id="@+id/reservationSummaryFullPaymentRow" layout="@layout/view_hotel_billing_line_row" />
                <include android:id="@+id/reservationSummaryDownPaymentRow" layout="@layout/view_hotel_billing_line_row" />
            </LinearLayout>

            <!-- Important Notice — Reserve-specific, plain text on the screen background rather
                 than inside a card. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/reservation_summary_important_notice"
                android:textColor="?attr/textOnScreen"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/reservation_summary_notice_body"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkboxTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/checkbox_agree_terms"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="top"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkboxCancellation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/checkbox_agree_cancellation"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/reservationSummaryReserveButton"
            style="@style/PrimaryButton"
            android:text="@string/button_reserve" />
    </LinearLayout>

</LinearLayout>
