<?xml version="1.0" encoding="utf-8"?>
<!-- One room/cottage/KTV card on the "Your Selected ..." screen (see
     HotelBookingFlowController#buildSelectableCard). Three states, driven purely from code:
     (1) the originally-chosen item, available: itemSelectedBadge visible, itemQuantityRow visible.
     (2) the originally-chosen item, unavailable: itemUnavailableBanner visible, itemQuantityRow
         gone, whole card dimmed via alpha (see buildSelectableCard).
     (3) any other available alternative: neither badge nor banner, itemQuantityRow visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:clipToOutline="true"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <ImageView
            android:id="@+id/itemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_item_thumb"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/itemUnavailableBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#B3000000"
            android:padding="10dp"
            android:text="@string/unavailable_room_message"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/itemSelectedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:text="@string/label_selected_badge"
            android:textColor="?attr/successText"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/itemType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/textPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/itemCapacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/textMuted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/itemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="?attr/textMuted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/itemPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/accentPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/itemQuantityRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/label_quantity"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/itemQuantityMinus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="4dp"
                android:src="@drawable/ic_minus"
                android:background="@drawable/bg_stepper_button" />

            <EditText
                android:id="@+id/itemQuantityValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="?attr/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@null"
                android:padding="0dp"
                android:minHeight="0dp"
                android:inputType="number"
                android:maxLength="3"
                android:selectAllOnFocus="true"
                android:imeOptions="actionDone"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/itemQuantityPlus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="4dp"
                android:src="@drawable/ic_plus"
                android:background="@drawable/bg_stepper_button" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
