<?xml version="1.0" encoding="utf-8"?>
<!-- One room/cottage/KTV card on the "Your Selected ..." screen (see
     HotelBookingFlowController#buildSelectableCard). Three states, driven purely from code:
     (1) the originally-chosen item, available: itemSelectedBadge visible, itemQuantityRow visible.
     (2) the originally-chosen item, unavailable: itemUnavailableBanner visible, itemQuantityRow
         gone, whole card dimmed via alpha (see buildSelectableCard).
     (3) any other available alternative: neither badge nor banner, itemQuantityRow visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:background="@drawable/bg_browse_card"
    android:elevation="4dp"
    android:outlineAmbientShadowColor="@color/card_shadow_ambient"
    android:outlineSpotShadowColor="@color/card_shadow_spot"
    android:clipToOutline="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_browse_image_top">

        <ImageView
            android:id="@+id/itemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/itemUnavailableBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#B3000000"
            android:padding="10dp"
            android:text="@string/unavailable_room_message"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/itemSelectedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_badge_available_on_image"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/label_selected_badge"
            android:textColor="?attr/successText"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- "X Room/Cottage/KTV Room Available" pill â€” house icon + count, matching the
             receptionist web admin's own "Total Available Units" chip. Hidden whenever
             itemUnavailableBanner is shown (see buildSelectableCard). -->
        <LinearLayout
            android:id="@+id/itemAvailableBadgeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_badge_available_on_image"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_home"
                android:tint="?attr/successText"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/itemAvailableBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/successText"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/itemType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="?attr/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_person"
            android:drawablePadding="6dp"
            android:drawableTint="?attr/iconMuted"
            android:gravity="center_vertical"
            android:textColor="?attr/textMuted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/itemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/textMuted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/itemPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/accentPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/itemQuantityRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/label_quantity"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/itemQuantityMinus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/bg_stepper_button" />

                <EditText
                    android:id="@+id/itemQuantityValue"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="?attr/textPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:inputType="number"
                    android:maxLength="3"
                    android:selectAllOnFocus="true"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/itemQuantityPlus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/bg_stepper_button" />

            </LinearLayout>

            <Button
                android:id="@+id/itemSelectButton"
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="96dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/button_select"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
