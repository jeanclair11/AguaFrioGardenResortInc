<?xml version="1.0" encoding="utf-8"?>
<!-- One accommodation result card in the vertically-scrolling results list on
     the merged Book search screen; shared by both the Hotel Rooms (live
     backend) and Cottages & KTV (static preview) result lists. See
     HotelBookingFlowController#renderAvailabilityResults. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:clipToOutline="true"
    android:elevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp">

        <ImageView
            android:id="@+id/accommodationImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/surfaceRaised"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/accommodationAvailabilityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_translucent"
            android:padding="6dp"
            android:src="@drawable/ic_heart_outline"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/accommodationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:textColor="?attr/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accommodationCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_person"
            android:drawableTint="?attr/textMuted"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/textMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/accommodationBedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_bed"
            android:drawableTint="?attr/textMuted"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/textMuted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Cottage/KTV cards only: the live available_quantity from the Admin Web catalog. -->
        <TextView
            android:id="@+id/accommodationAvailableUnits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/textMuted"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/dividerColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/accommodationPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/accentPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/accommodationBookNowButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_button_outline_accent"
                android:text="@string/button_book_now"
                android:textColor="?attr/accentPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Cottage cards only: quantity stepper, replacing accommodationBookNowButton above
             (which is gone for this variant). See ReservationFlowController/HotelBookingFlowController. -->
        <LinearLayout
            android:id="@+id/accommodationQuantityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_quantity"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/accommodationQuantityMinus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="4dp"
                android:src="@drawable/ic_minus"
                android:background="@drawable/bg_stepper_button" />

            <EditText
                android:id="@+id/accommodationQuantityValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="?attr/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@null"
                android:padding="0dp"
                android:minHeight="0dp"
                android:inputType="number"
                android:maxLength="3"
                android:selectAllOnFocus="true"
                android:imeOptions="actionDone"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/accommodationQuantityPlus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="4dp"
                android:src="@drawable/ic_plus"
                android:background="@drawable/bg_stepper_button" />

        </LinearLayout>

        <!-- Cottage cards only: finalizes this card's quantity and proceeds. -->
        <Button
            android:id="@+id/accommodationReserveButton"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:minHeight="0dp"
            android:text="@string/button_reserve"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- KTV cards only: a single select/selected toggle, replacing accommodationBookNowButton
             above (which is gone for this variant) — a KTV room is a single mutually-exclusive
             pick, not a quantity. -->
        <Button
            android:id="@+id/accommodationSelectButton"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:minHeight="0dp"
            android:text="@string/button_select"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
