<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <!-- Top bar: resort logo + name on the left, notification and profile
         actions on the right (paired, matching the reference header). Shown
         only on the Home tab (see DashboardActivity#updateChromeVisibility);
         theme switching lives solely in Profile > Preferences, so the header
         doesn't need its own toggle. -->
    <LinearLayout
        android:id="@+id/topBarRow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_top_bar_gradient">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/agua_frio_logo"
            android:importantForAccessibility="no" />

        <!-- Brand lockup: "AGUA FRIO" header over an accent-colored
             "GARDEN RESORT INC." subheader, matching the auth screen. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:text="@string/resort_title"
                android:textColor="?attr/onTopBar"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:text="@string/resort_subtitle"
                android:textColor="?attr/accentPrimary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/bellButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:src="@drawable/ic_bell"
                android:tint="?attr/onTopBar"
                android:contentDescription="@string/open_notifications" />

            <TextView
                android:id="@+id/bellBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:minWidth="16dp"
                android:background="@drawable/bg_badge_count"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:importantForAccessibility="no"
                tools:text="9" />

        </FrameLayout>

        <ImageView
            android:id="@+id/profileButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            android:tint="?attr/onTopBar"
            android:contentDescription="@string/profile" />

    </LinearLayout>

    <!-- Active module screen -->

    <FrameLayout
        android:id="@+id/moduleContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dividerColor" />

    <!-- Bottom navigation: Home, Reserve, Book, Chat, Feedback.
         Always visible, on every screen. -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="?attr/navBarBackground" />

</LinearLayout>
