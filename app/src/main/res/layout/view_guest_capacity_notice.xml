<?xml version="1.0" encoding="utf-8"?>
<!-- Informational note shown (never as an error, never blocking) when the party is larger than the
     combined standard capacity of the rooms picked. Included on the Number of Guests screen and on
     Review Your Selection; HotelBookingFlowController toggles its visibility. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:elevation="4dp"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/card_shadow_ambient"
    android:outlineSpotShadowColor="@color/card_shadow_spot"
    android:padding="14dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info" />

    <TextView
        android:id="@+id/capacityNoticeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:lineSpacingExtra="2dp"
        android:text="@string/notice_guests_exceed_capacity"
        android:textColor="?attr/textMuted"
        android:textSize="12sp" />

</LinearLayout>
