<?xml version="1.0" encoding="utf-8"?>
<!-- Hotel booking flow's own focused "Choose Your Stay Dates" gate screen (check-in, check-out,
     the rooms free for those dates, Next) — the Book/Reserve tabs' shared entry point for Hotel Room, reached
     either from their "What do you want to book/reserve?" picker or from a Room Overview's "Book
     Now"/"Reserve Now". See HotelBookingFlowController#bindRoomDates. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/roomDatesHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/room_dates_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <!-- Check-in Date -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="22dp"
                android:text="@string/label_check_in" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:id="@+id/roomDatesCheckInField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_calendar"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/roomDatesCheckInDateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/hint_select_date"
                        android:textColor="?attr/textPrimary"
                        android:alpha="0.5"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/roomDatesCheckInDayText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/textMuted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    android:importantForAccessibility="no" />

            </com.aguafriogarden.resortinc.AuthInputField>
            <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/roomDatesCheckInError" style="@style/AuthFieldError" />

            <!-- Check-out Date -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_check_out" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:id="@+id/roomDatesCheckOutField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_calendar"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/roomDatesCheckOutDateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/hint_select_date"
                        android:textColor="?attr/textPrimary"
                        android:alpha="0.5"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/roomDatesCheckOutDayText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/textMuted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    android:importantForAccessibility="no" />

            </com.aguafriogarden.resortinc.AuthInputField>
            <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/roomDatesCheckOutError" style="@style/AuthFieldError" />

            <!-- Available rooms for the chosen dates. Filled by HotelBookingFlowController#renderRoomList:
                 one card per room type that has a room free, each with its own quantity stepper. A
                 type with nothing free is never listed. The message line stands in for the list
                 while there are no dates yet, while loading, when nothing is free, and on a failure
                 (with the retry button). -->
            <TextView
                android:id="@+id/roomDatesRoomsTitle"
                style="@style/FieldLabel"
                android:layout_marginTop="26dp"
                android:text="@string/room_selection_title" />

            <TextView
                android:id="@+id/roomDatesRoomsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/roomDatesRetryButton"
                style="@style/SecondaryButton"
                android:text="@string/button_try_again"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/roomDatesRoomsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/roomDatesNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />

    </LinearLayout>

</LinearLayout>
