<?xml version="1.0" encoding="utf-8"?>
<!-- One booking row on the My Bookings screen. Booking-flavored twin of
     view_reservation_card.xml. See HotelBookingFlowController#bindMyBookingsList. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <TextView
        android:id="@+id/bookingCardReferenceNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/textPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/bookingCardStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_progress_dot_filled" />

        <TextView
            android:id="@+id/bookingCardStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.03"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/bookingCardType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/textMuted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/bookingCardAccommodation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/textPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bookingCardDateRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/textMuted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/bookingCardGuests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/textMuted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/bookingCardViewDetailsButton"
        style="@style/SecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:text="@string/button_view_details"
        android:textSize="12sp" />

</LinearLayout>
