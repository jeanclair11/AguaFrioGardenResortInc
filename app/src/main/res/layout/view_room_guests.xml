<?xml version="1.0" encoding="utf-8"?>
<!-- Hotel booking flow's "Number of Guests" step, after the guest has chosen dates and rooms (see
     HotelBookingFlowController#bindRoomGuests). The party size never limits the booking: when it
     is larger than the combined standard capacity of the rooms picked, only the informational
     notice below appears, and Next stays available. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/roomGuestsHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:id="@+id/roomGuestsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/room_guests_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <!-- Number of Adults -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="22dp"
                android:text="@string/label_adults" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/roomGuestsAdultsMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/bg_stepper_button" />

                <EditText
                    android:id="@+id/roomGuestsAdultsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:inputType="number"
                    android:maxLength="2"
                    android:selectAllOnFocus="true"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/roomGuestsAdultsPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/bg_stepper_button" />

            </com.aguafriogarden.resortinc.AuthInputField>

            <!-- Number of Children -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_children" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/roomGuestsChildrenMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/bg_stepper_button" />

                <EditText
                    android:id="@+id/roomGuestsChildrenValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:inputType="number"
                    android:maxLength="2"
                    android:selectAllOnFocus="true"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/roomGuestsChildrenPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/bg_stepper_button" />

            </com.aguafriogarden.resortinc.AuthInputField>

            <!-- Cottage only: how the entrance fee uses the party (set from code). -->
            <TextView
                android:id="@+id/roomGuestsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Shown only while the party is larger than the rooms' combined standard capacity. -->
            <include
                android:id="@+id/roomGuestsCapacityNotice"
                layout="@layout/view_guest_capacity_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/roomGuestsNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />

    </LinearLayout>

</LinearLayout>
