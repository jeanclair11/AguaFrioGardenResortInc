<?xml version="1.0" encoding="utf-8"?>
<!-- Small tappable "Promo Coupons" card above Payment Summary on the Billing and Reservation
     Summary screens. See HotelBookingFlowController#bindPromoCoupons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/promoCouponCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_browse_card"
    android:clickable="true"
    android:elevation="4dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/card_shadow_ambient"
    android:outlineSpotShadowColor="@color/card_shadow_spot"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_coupon_icon">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_coupon" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/promo_coupons_title"
            android:textColor="?attr/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/promoCouponSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/promo_coupons_none"
            android:textColor="?attr/textMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
