<?xml version="1.0" encoding="utf-8"?>
<!-- "Your Selected Room/s" / "...Cottage/s" / "...KTV Room/s" screen: shown after the guest taps
     Next on the Room/Cottage/KTV Overview's dedicated dates screen. Shows the originally-chosen
     item pre-selected with a quantity control if it's available, or grayed with an unavailable
     message if not; other available alternatives are listed below (immediately, if the original
     pick failed, or only after "Add Another Room" otherwise). See
     HotelBookingFlowController#bindRoomSelection / #bindCottageSelection / #bindKtvSelection,
     which all share this one layout, only the text/data differs per category. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/itemSelectionHeaderBar"
                layout="@layout/view_screen_header" />

            <!-- Originally-chosen item slot: exactly one card, built by buildSelectableCard. -->
            <FrameLayout
                android:id="@+id/itemSelectionOriginSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/itemSelectionOtherContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/itemSelectionAddAnotherButton"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:textColor="?attr/textPrimary"
            android:visibility="gone" />

        <Button
            android:id="@+id/itemSelectionNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />

    </LinearLayout>

</LinearLayout>
