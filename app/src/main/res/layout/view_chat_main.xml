<?xml version="1.0" encoding="utf-8"?>
<!-- Chat tab: a fixed header, a scrollable conversation (with a welcome
     card + quick-question chips while empty), and a fixed message composer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_header_title"
                android:textColor="?attr/textOnScreen"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_online_dot"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/chat_online_status"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/chat_header_subtitle"
            android:textColor="?attr/textOnScreenMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dividerColor" />

    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/chatWelcomeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="24dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_chat"
                    android:tint="?attr/accentPrimary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/chat_empty_title"
                    android:textColor="?attr/textPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/chat_empty_message"
                    android:textColor="?attr/textMuted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/chatChipsScroller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/chatChipsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipRoomAvailability"
                        style="@style/ChatChip"
                        android:text="@string/chip_room_availability" />

                    <TextView
                        android:id="@+id/chipBookingRequirements"
                        style="@style/ChatChip"
                        android:text="@string/chip_booking_requirements" />

                    <TextView
                        android:id="@+id/chipResortRates"
                        style="@style/ChatChip"
                        android:text="@string/chip_resort_rates" />

                    <TextView
                        android:id="@+id/chipPoolInfo"
                        style="@style/ChatChip"
                        android:text="@string/chip_pool_info" />

                    <TextView
                        android:id="@+id/chipCottageInfo"
                        style="@style/ChatChip"
                        android:text="@string/chip_cottage_info" />

                    <TextView
                        android:id="@+id/chipBookingStatus"
                        style="@style/ChatChip"
                        android:text="@string/chip_booking_status" />

                    <TextView
                        android:id="@+id/chipPaymentInstructions"
                        style="@style/ChatChip"
                        android:text="@string/chip_payment_instructions" />

                    <TextView
                        android:id="@+id/chipCancellationPolicy"
                        style="@style/ChatChip"
                        android:text="@string/chip_cancellation_policy" />

                    <TextView
                        android:id="@+id/chipResortAmenities"
                        style="@style/ChatChip"
                        android:text="@string/chip_resort_amenities" />

                    <TextView
                        android:id="@+id/chipContactReceptionist"
                        style="@style/ChatChip"
                        android:layout_marginEnd="0dp"
                        android:text="@string/chip_contact_receptionist" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/chatMessageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/chatMessageField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="4"
            android:minHeight="44dp"
            android:gravity="center_vertical|start"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_chat_message"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="?attr/textPrimary"
            android:textColorHint="?attr/textHint"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/chatSendButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_forward"
            android:background="@drawable/bg_send_button"
            android:contentDescription="@string/hint_chat_message" />

    </LinearLayout>

</LinearLayout>
