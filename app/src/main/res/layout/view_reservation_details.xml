<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation Module, screens 8-12: a single dynamic details screen driven
     by status/sub-status (Pending/Additional-Confirmation/Alternative-
     Schedule/Confirmed/Rejected/Cancelled all render here). See
     ReservationFlowController#bindDetails. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/reservationDetailsHeaderBar"
            layout="@layout/view_screen_header" />

        <!-- Status banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/detailsStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_progress_dot_filled" />

                <TextView
                    android:id="@+id/detailsStatusLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.04"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailsStatusDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Reservation info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <include android:id="@+id/detailsRowReference" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/detailsRowAccommodation" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/detailsRowDate" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/detailsRowGuests" layout="@layout/view_hotel_label_value_row" />
        </LinearLayout>

        <!-- Alternative schedule proposal (only shown for SUB_ALTERNATIVE_PROPOSED) -->
        <LinearLayout
            android:id="@+id/detailsAltScheduleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_alt_schedule_1"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_alt_schedule_2"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <include android:id="@+id/detailsRowCurrentRequest" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/detailsRowProposedSchedule" layout="@layout/view_hotel_label_value_row" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/detailsDeclineButton"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/button_decline" />

                <Button
                    android:id="@+id/detailsAcceptButton"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/button_accept_new_schedule" />
            </LinearLayout>
        </LinearLayout>

        <!-- Additional confirmation required (only shown for SUB_ADDITIONAL_CONFIRMATION) -->
        <LinearLayout
            android:id="@+id/detailsAdditionalConfirmationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_additional_confirmation_1"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_additional_confirmation_2"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_additional_confirmation_3"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Confirmed next-step note (only shown for STATUS_CONFIRMED) -->
        <LinearLayout
            android:id="@+id/detailsConfirmedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_confirmed_next_step"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Rejected reason + recovery actions (only shown for SUB_REJECTED) -->
        <LinearLayout
            android:id="@+id/detailsRejectedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView style="@style/BillingSectionLabel" android:text="@string/section_reason" />

            <TextView
                android:id="@+id/detailsRejectedReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/detailsTryAnotherDateButton"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/button_try_another_date" />

            <Button
                android:id="@+id/detailsViewOtherRoomsButton"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/button_view_other_rooms" />

            <Button
                android:id="@+id/detailsBackToListButton"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/button_back_to_my_reservations" />
        </LinearLayout>

        <!-- Cancelled reason (shown for cancelled sub-statuses other than Rejected) -->
        <LinearLayout
            android:id="@+id/detailsCancelledReasonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView style="@style/BillingSectionLabel" android:text="@string/section_reason" />

            <TextView
                android:id="@+id/detailsCancelledReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Timeline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:textColor="?attr/textOnScreen"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="@string/section_reservation_timeline" />

        <LinearLayout
            android:id="@+id/detailsTimelineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
