<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/signup_heading"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/signup_subheading"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- First Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="22dp"
        android:text="@string/label_first_name" />

    <LinearLayout
        android:id="@+id/firstNameContainer"
        style="@style/InputField">

        <EditText
            android:id="@+id/firstNameField"
            style="@style/InputEditText"
            android:hint="@string/hint_first_name"
            android:inputType="textPersonName" />
    </LinearLayout>

    <TextView
        android:id="@+id/firstNameError"
        style="@style/FieldError" />

    <!-- Middle Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_middle_name" />

    <LinearLayout
        android:id="@+id/middleNameContainer"
        style="@style/InputField">

        <EditText
            android:id="@+id/middleNameField"
            style="@style/InputEditText"
            android:hint="@string/hint_middle_name"
            android:inputType="textPersonName" />
    </LinearLayout>

    <TextView
        android:id="@+id/middleNameError"
        style="@style/FieldError" />

    <!-- Last Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_last_name" />

    <LinearLayout
        android:id="@+id/lastNameContainer"
        style="@style/InputField">

        <EditText
            android:id="@+id/lastNameField"
            style="@style/InputEditText"
            android:hint="@string/hint_last_name"
            android:inputType="textPersonName" />
    </LinearLayout>

    <TextView
        android:id="@+id/lastNameError"
        style="@style/FieldError" />

    <!-- Username -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_username" />

    <LinearLayout
        android:id="@+id/usernameContainer"
        style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_person" />

        <EditText
            android:id="@+id/usernameField"
            style="@style/InputEditText"
            android:hint="@string/hint_username"
            android:inputType="text" />
    </LinearLayout>

    <TextView
        android:id="@+id/usernameError"
        style="@style/FieldError" />

    <!-- Email -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_email" />

    <LinearLayout
        android:id="@+id/emailContainer"
        style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_email" />

        <EditText
            android:id="@+id/emailField"
            style="@style/InputEditText"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress" />
    </LinearLayout>

    <TextView
        android:id="@+id/emailError"
        style="@style/FieldError" />

    <!-- Phone Number -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_phone" />

    <LinearLayout
        android:id="@+id/phoneContainer"
        style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_phone" />

        <EditText
            android:id="@+id/phoneField"
            style="@style/InputEditText"
            android:hint="@string/hint_phone"
            android:inputType="phone" />
    </LinearLayout>

    <TextView
        android:id="@+id/phoneError"
        style="@style/FieldError" />

    <!-- Gender and Birth Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_gender" />

            <LinearLayout
                android:id="@+id/genderContainer"
                style="@style/InputField"
                android:paddingEnd="4dp">

                <Spinner
                    android:id="@+id/genderSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/genderError"
                style="@style/FieldError" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_birth_date" />

            <LinearLayout
                android:id="@+id/birthDateContainer"
                style="@style/InputField">

                <EditText
                    android:id="@+id/birthDateField"
                    style="@style/InputEditText"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_birth_date" />
            </LinearLayout>

            <TextView
                android:id="@+id/birthDateError"
                style="@style/FieldError" />
        </LinearLayout>
    </LinearLayout>

    <!-- Password -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_create_password" />

    <LinearLayout
        android:id="@+id/passwordContainer"
        style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_lock" />

        <EditText
            android:id="@+id/passwordField"
            style="@style/InputEditText"
            android:hint="@string/hint_create_password"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/passwordToggle"
            style="@style/InputTrailingIcon"
            android:src="@drawable/ic_eye" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/passwordStrengthText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/passwordError"
        style="@style/FieldError" />

    <!-- Confirm Password -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_confirm_password" />

    <LinearLayout
        android:id="@+id/confirmPasswordContainer"
        style="@style/InputField">

        <ImageView
            style="@style/InputIcon"
            android:src="@drawable/ic_lock" />

        <EditText
            android:id="@+id/confirmPasswordField"
            style="@style/InputEditText"
            android:hint="@string/hint_confirm_password"
            android:inputType="textPassword" />
    </LinearLayout>

    <TextView
        android:id="@+id/confirmPasswordError"
        style="@style/FieldError" />

    <!-- Profile Picture Upload -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="20dp"
        android:text="@string/label_profile_picture" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/profilePreview"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_input"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person" />

        <Button
            android:id="@+id/uploadProfileButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_upload"
            android:textAllCaps="false"
            android:textColor="@color/primary_blue" />
    </LinearLayout>

    <!-- Government ID Upload -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="20dp"
        android:text="@string/label_government_id" />

    <LinearLayout
        android:id="@+id/govIdContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/uploadGovIdButton"
            style="@style/PrimaryButton"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:text="@string/button_upload"
            android:textColor="@color/primary_blue" />

        <ImageView
            android:id="@+id/govIdPreview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/govIdError"
        style="@style/FieldError" />

    <!-- Terms and Conditions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="top"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/termsCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <TextView
            android:id="@+id/termsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:lineSpacingExtra="1dp"
            android:text="@string/terms_and_conditions"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/termsError"
        style="@style/FieldError" />

    <Button
        android:id="@+id/createAccountButton"
        style="@style/PrimaryButton"
        android:layout_marginTop="24dp"
        android:enabled="false"
        android:text="@string/create_account" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/have_account_prompt"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/goToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="4dp"
            android:text="@string/log_in_link"
            android:textColor="@color/accent_orange"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
