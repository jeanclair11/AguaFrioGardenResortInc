<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up step 4: email OTP verification, mirrors the website's post-registration flow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/otp_heading"
        android:textColor="?attr/textPrimary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/signup_step4_subheading"
        android:textColor="?attr/textMuted"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/otp_subheading"
        android:textColor="?attr/textMuted"
        android:textSize="13sp" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="24dp"
        android:text="@string/label_otp_code" />

    <LinearLayout style="@style/InputField">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_lock" />

        <EditText
            android:id="@+id/otpField"
            style="@style/InputEditText"
            android:hint="@string/hint_otp_code"
            android:inputType="number"
            android:maxLength="6" />
    </LinearLayout>

    <TextView
        android:id="@+id/otpError"
        style="@style/FieldError" />

    <!-- Verify: the spinner sits over the button and is gone unless a request is running. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/verifyOtpButton"
            style="@style/PrimaryButton"
            android:text="@string/button_verify" />

        <ProgressBar
            android:id="@+id/verifyOtpProgress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/onPrimaryButton"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/resendOtpButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:background="?android:attr/selectableItemBackground"
        android:padding="6dp"
        android:text="@string/resend_code"
        android:textColor="?attr/accentPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
