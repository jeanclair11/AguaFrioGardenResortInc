<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <include
            android:id="@+id/headerBar"
            layout="@layout/view_screen_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/write_feedback_subtitle"
            android:textColor="?attr/textOnScreenMuted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_rate_experience"
                android:textColor="?attr/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/fwStarRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/fwStar1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/fwStar2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/fwStar3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/fwStar4"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/fwStar5"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/fwRatingError"
            style="@style/FieldError"
            android:gravity="center" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="20dp"
            android:text="@string/label_share_feedback" />

        <EditText
            android:id="@+id/fwMessageField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="6"
            android:gravity="top|start"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_feedback_message"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:textColor="?attr/textPrimary"
            android:textColorHint="?attr/textHint"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/fwCharCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:textColor="?attr/textOnScreenMuted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/fwMessageError"
            style="@style/FieldError" />

        <Button
            android:id="@+id/fwSubmitButton"
            style="@style/PrimaryButton"
            android:layout_marginTop="20dp"
            android:text="@string/button_submit_feedback" />

        <LinearLayout
            android:id="@+id/fwSubmittingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="?attr/accentPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/feedback_submitting_message"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
