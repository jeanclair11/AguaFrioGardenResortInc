<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation Module, screen 2: available accommodations grouped by
     category, one selectable at a time. See
     ReservationFlowController#bindRooms. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/reservationRoomsHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="@string/reservation_rooms_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/reservationRoomsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/reservationRoomsNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />
    </LinearLayout>

</LinearLayout>
