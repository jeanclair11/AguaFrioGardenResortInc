<?xml version="1.0" encoding="utf-8"?>
<!-- Package booking's first screen ("Choose Your Date"): one date (check-in, or the visit day),
     adults, children, Next. Reached from Package Details' "Avail Package"; Next checks the package
     is still active, valid that day and fully available before going on (see
     HotelBookingFlowController#bindPackageDates). Laid out like view_room_booking_dates.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/packageDatesHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:id="@+id/packageDatesPackageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/textOnScreen"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/packageDatesSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/packageDatesDateLabel"
                style="@style/FieldLabel"
                android:layout_marginTop="22dp" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:id="@+id/packageDatesDateField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/packageDatesDateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.5"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/hint_select_date"
                        android:textColor="?attr/textPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/packageDatesDayText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/textMuted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />

            </com.aguafriogarden.resortinc.AuthInputField>
            <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/packageDatesDateError" style="@style/AuthFieldError" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_adults" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/packageDatesAdultsMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_stepper_button"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus" />

                <EditText
                    android:id="@+id/packageDatesAdultsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="2"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:text="1"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/packageDatesAdultsPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_stepper_button"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus" />

            </com.aguafriogarden.resortinc.AuthInputField>

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_children" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/packageDatesChildrenMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_stepper_button"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus" />

                <EditText
                    android:id="@+id/packageDatesChildrenValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="2"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/packageDatesChildrenPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_stepper_button"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus" />

            </com.aguafriogarden.resortinc.AuthInputField>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/hotelReviewNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />

    </LinearLayout>

</LinearLayout>
