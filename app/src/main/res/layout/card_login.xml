<?xml version="1.0" encoding="utf-8"?>
<!-- "Welcome Back" login content, swapped inside the fixed white card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/login_heading"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/login_subheading"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Username / Email -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="24dp"
        android:text="@string/label_username_email" />

    <LinearLayout style="@style/InputField">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />

        <EditText
            android:id="@+id/usernameField"
            style="@style/InputEditText"
            android:autofillHints="username,emailAddress"
            android:hint="@string/hint_username_email"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:nextFocusForward="@+id/passwordField"
            android:nextFocusDown="@+id/passwordField" />
    </LinearLayout>

    <TextView
        android:id="@+id/usernameError"
        style="@style/FieldError" />

    <!-- Password label + Forgot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:text="@string/label_password" />

        <TextView
            android:id="@+id/forgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="4dp"
            android:text="@string/forgot_password"
            android:textColor="@color/accent_orange"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout style="@style/InputField">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_lock" />

        <EditText
            android:id="@+id/passwordField"
            style="@style/InputEditText"
            android:autofillHints="password"
            android:hint="@string/hint_password"
            android:imeActionLabel="@string/log_in"
            android:imeOptions="actionGo"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/passwordToggle"
            style="@style/InputTrailingIcon"
            android:src="@drawable/ic_eye" />
    </LinearLayout>

    <TextView
        android:id="@+id/passwordError"
        style="@style/FieldError" />

    <!-- Log in: the spinner sits over the button and is gone unless a request is running. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/loginButton"
            style="@style/PrimaryButton"
            android:text="@string/log_in" />

        <ProgressBar
            android:id="@+id/loginProgress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_account_prompt"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/goToSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="4dp"
            android:text="@string/sign_up"
            android:textColor="@color/accent_orange"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
