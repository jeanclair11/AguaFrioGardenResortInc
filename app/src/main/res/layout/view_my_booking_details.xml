<?xml version="1.0" encoding="utf-8"?>
<!-- Book tab: a single dynamic booking details screen driven by status/
     sub-status (Pending/Additional-Confirmation/Alternative-Schedule/
     Confirmed/Rejected/Cancelled all render here). Booking-flavored twin of
     view_reservation_details.xml. See
     HotelBookingFlowController#bindBookingDetails. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/bookingDetailsHeaderBar"
            layout="@layout/view_screen_header" />

        <!-- Status banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/bookingDetailsStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_progress_dot_filled" />

                <TextView
                    android:id="@+id/bookingDetailsStatusLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.04"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/bookingDetailsStatusDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Booking info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <include android:id="@+id/bookingDetailsRowReference" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/bookingDetailsRowAccommodation" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/bookingDetailsRowDate" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/bookingDetailsRowGuests" layout="@layout/view_hotel_label_value_row" />
        </LinearLayout>

        <!-- Alternative schedule proposal (only shown for SUB_ALTERNATIVE_PROPOSED) -->
        <LinearLayout
            android:id="@+id/bookingDetailsAltScheduleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_alt_schedule_1"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_alt_schedule_2"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <include android:id="@+id/bookingDetailsRowCurrentRequest" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/bookingDetailsRowProposedSchedule" layout="@layout/view_hotel_label_value_row" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bookingDetailsDeclineButton"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/button_decline" />

                <Button
                    android:id="@+id/bookingDetailsAcceptButton"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/button_accept_new_schedule" />
            </LinearLayout>
        </LinearLayout>

        <!-- Additional confirmation required (only shown for SUB_ADDITIONAL_CONFIRMATION) -->
        <LinearLayout
            android:id="@+id/bookingDetailsAdditionalConfirmationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_additional_confirmation_booking_1"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_additional_confirmation_booking_2"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_additional_confirmation_3"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Confirmed next-step note (only shown for STATUS_CONFIRMED) -->
        <LinearLayout
            android:id="@+id/bookingDetailsConfirmedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_confirmed_next_step_booking"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Rejected reason + recovery actions (only shown for SUB_REJECTED) -->
        <LinearLayout
            android:id="@+id/bookingDetailsRejectedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView style="@style/BillingSectionLabel" android:text="@string/section_reason" />

            <TextView
                android:id="@+id/bookingDetailsRejectedReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/bookingDetailsTryAnotherDateButton"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/button_try_another_date" />

            <Button
                android:id="@+id/bookingDetailsViewOtherRoomsButton"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/button_view_other_rooms" />

            <Button
                android:id="@+id/bookingDetailsBackToListButton"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/button_back_to_my_bookings" />
        </LinearLayout>

        <!-- Cancelled reason (shown for cancelled sub-statuses other than Rejected) -->
        <LinearLayout
            android:id="@+id/bookingDetailsCancelledReasonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <TextView style="@style/BillingSectionLabel" android:text="@string/section_reason" />

            <TextView
                android:id="@+id/bookingDetailsCancelledReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Timeline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:textColor="?attr/textOnScreen"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="@string/section_booking_timeline" />

        <LinearLayout
            android:id="@+id/bookingDetailsTimelineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
