<?xml version="1.0" encoding="utf-8"?>
<!-- Shared "What do you want to book/reserve?" entry gate (Hotel Room/Cottage/KTV Room) for both
     the Book and Reserve tabs — see ReserveCatalogController#showPicker and
     BookingCatalogController#showPicker. Picking one hands off to HotelBookingFlowController's
     flow at that category's own focused dates-entry screen (reserveOnly true for Reserve, false
     for Book). reservePickerTitleText's text is set in Java per tab since the two need different
     wording ("book" vs "reserve"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/reservePickerTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="@string/reserve_picker_title"
                android:textColor="?attr/textOnScreen"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/reservePickerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
