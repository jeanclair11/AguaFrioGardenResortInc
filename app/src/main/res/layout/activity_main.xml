<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- Fixed Header -->
    <include
        android:id="@+id/header"
        layout="@layout/view_header"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="top" />

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Spacer equal to almost the whole header -->
            <Space
                android:id="@+id/headerSpacer"
                android:layout_width="match_parent"
                android:layout_height="250dp" />

            <!-- Floating Card -->
            <FrameLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                />

        </LinearLayout>

    </ScrollView>

    <!-- Light/dark mode toggle floating over the header photo. Sits after
         the ScrollView so it receives taps. -->
    <ImageView
        android:id="@+id/themeToggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:padding="11dp"
        android:background="@drawable/bg_theme_toggle"
        android:elevation="4dp"
        android:outlineAmbientShadowColor="@color/card_shadow_ambient"
        android:outlineSpotShadowColor="@color/card_shadow_spot"
        android:tint="@color/white"
        android:contentDescription="@string/toggle_theme" />

</FrameLayout>