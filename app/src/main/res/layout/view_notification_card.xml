<?xml version="1.0" encoding="utf-8"?>
<!-- One notification row on the Alerts tab. See
     NotificationController#bindNotification. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <TextView
        android:id="@+id/notificationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/textPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notificationMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textColor="?attr/textMuted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/notificationTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/textHint"
        android:textSize="11sp" />

    <Button
        android:id="@+id/notificationActionButton"
        style="@style/SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
