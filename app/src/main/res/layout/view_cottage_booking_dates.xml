<?xml version="1.0" encoding="utf-8"?>
<!-- Hotel booking flow's own focused "Choose Your Visit Date" gate screen (rate type, date, time,
     adults, children, total guest, Next) for Cottages — the Book/Reserve tabs' shared entry
     point, reached either from their "What do you want to book/reserve?" picker or from a
     Cottage Overview's "Book Now"/"Reserve Now" — deliberately distinct from the hotel-room dates
     screen (view_room_booking_dates.xml). See HotelBookingFlowController#bindCottageDatesEntry. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/cottageDatesHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/cottage_dates_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <!-- Rate Type -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="22dp"
                android:text="@string/label_rate_type" />

            <RadioGroup
                android:id="@+id/cottageDatesRateTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/cottageDatesRateDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/accentPrimary"
                    android:text="@string/rate_type_day"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/cottageDatesRateNight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/accentPrimary"
                    android:text="@string/rate_type_night"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />

            </RadioGroup>
            <TextView android:id="@+id/cottageDatesRateTypeError" style="@style/FieldError" />

            <!-- Date -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_date" />

            <LinearLayout
                android:id="@+id/cottageDatesDateField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_selector"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_calendar"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/cottageDatesDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/hint_select_date"
                    android:textColor="?attr/textPrimary"
                    android:alpha="0.5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    android:importantForAccessibility="no" />

            </LinearLayout>
            <TextView android:id="@+id/cottageDatesDateError" style="@style/FieldError" />

            <!-- Time -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_time" />

            <LinearLayout
                android:id="@+id/cottageDatesTimeField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_selector"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_clock"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/cottageDatesTimeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/hint_select_time"
                    android:textColor="?attr/textPrimary"
                    android:alpha="0.5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    android:importantForAccessibility="no" />

            </LinearLayout>
            <TextView android:id="@+id/cottageDatesTimeError" style="@style/FieldError" />

            <!-- Guests -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_stay_guests" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_selector"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_adults"
                        android:textColor="?attr/textPrimary"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/cottageDatesAdultsMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_minus"
                        android:background="@drawable/bg_stepper_button" />

                    <EditText
                        android:id="@+id/cottageDatesAdultsValue"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="?attr/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:padding="0dp"
                        android:minHeight="0dp"
                        android:inputType="number"
                        android:maxLength="2"
                        android:selectAllOnFocus="true"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/cottageDatesAdultsPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_plus"
                        android:background="@drawable/bg_stepper_button" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_children"
                        android:textColor="?attr/textPrimary"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/cottageDatesChildrenMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_minus"
                        android:background="@drawable/bg_stepper_button" />

                    <EditText
                        android:id="@+id/cottageDatesChildrenValue"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="?attr/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:padding="0dp"
                        android:minHeight="0dp"
                        android:inputType="number"
                        android:maxLength="2"
                        android:selectAllOnFocus="true"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/cottageDatesChildrenPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_plus"
                        android:background="@drawable/bg_stepper_button" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_total_guest"
                        android:textColor="?attr/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cottageDatesTotalGuestValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="?attr/accentPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/note_entrance_fee_calculation"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/cottageDatesNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />

    </LinearLayout>

</LinearLayout>
