<?xml version="1.0" encoding="utf-8"?>
<!-- Wizard step 3: who the booking is for, optional guest/children details,
     and a special request note. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="0dp"
            android:text="@string/label_who_is_this_for" />

        <RadioGroup
            android:id="@+id/bookingForGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/cardForMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_selectable_card_selected"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true">

                <RadioButton
                    android:id="@+id/radioForMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:checked="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/option_booking_for_me"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardForSomeoneElse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_selectable_card"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true">

                <RadioButton
                    android:id="@+id/radioForSomeoneElse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/option_booking_for_someone_else"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp" />
            </LinearLayout>
        </RadioGroup>

        <!-- Revealed only when booking on behalf of someone else. -->
        <LinearLayout
            android:id="@+id/guestInfoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="20dp"
                android:text="@string/label_guest_first_name" />

            <LinearLayout style="@style/InputField">

                <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/guestFirstNameField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_guest_first_name"
                    android:inputType="textPersonName" />
            </LinearLayout>

            <TextView
                android:id="@+id/guestFirstNameError"
                style="@style/FieldError" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_guest_middle_name" />

            <LinearLayout style="@style/InputField">

                <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/guestMiddleNameField"
                    style="@style/InputEditText"
                    android:inputType="textPersonName" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_guest_last_name" />

            <LinearLayout style="@style/InputField">

                <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/guestLastNameField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_guest_last_name"
                    android:inputType="textPersonName" />
            </LinearLayout>

            <TextView
                android:id="@+id/guestLastNameError"
                style="@style/FieldError" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_guest_gender" />

            <LinearLayout
                style="@style/InputField"
                android:paddingEnd="4dp">

                <Spinner
                    android:id="@+id/guestGenderSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/guestGenderError"
                style="@style/FieldError" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_guest_birth_date" />

            <LinearLayout style="@style/InputField">

                <ImageView style="@style/InputIcon" android:src="@drawable/ic_calendar" />

                <EditText
                    android:id="@+id/guestBirthDateField"
                    style="@style/InputEditText"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_select_date" />
            </LinearLayout>

            <TextView
                android:id="@+id/guestBirthDateError"
                style="@style/FieldError" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_guest_contact" />

            <LinearLayout style="@style/InputField">

                <ImageView style="@style/InputIcon" android:src="@drawable/ic_phone" />

                <EditText
                    android:id="@+id/guestContactField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_phone"
                    android:inputType="phone" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_guest_relationship" />

            <LinearLayout
                style="@style/InputField"
                android:paddingEnd="4dp">

                <Spinner
                    android:id="@+id/guestRelationshipSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/guestRelationshipError"
                style="@style/FieldError" />
        </LinearLayout>

        <!-- Revealed only when step 1's children count is greater than zero. -->
        <LinearLayout
            android:id="@+id/childrenInfoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="20dp"
                android:text="@string/label_children_info" />

            <LinearLayout
                android:id="@+id/childrenAgesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="20dp"
            android:text="@string/label_special_request" />

        <EditText
            android:id="@+id/specialRequestField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="4"
            android:gravity="top|start"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_special_request"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="?attr/textPrimary"
            android:textColorHint="?attr/textHint"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="28dp">

            <Button
                android:id="@+id/step3BackButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/button_back" />

            <Button
                android:id="@+id/step3ProceedButton"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/button_proceed" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
