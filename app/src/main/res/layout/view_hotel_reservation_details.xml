<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation Confirmed's "View Reservation" button — a standalone status screen for the
     reservation just submitted (reference/accommodation/date/guest, guest info, and a mock Pay
     Now, since there's no backend to actually process payment against yet). See
     HotelBookingFlowController#bindReservationDetails. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/reservationDetailsHeaderBar"
                layout="@layout/view_screen_header" />

            <!-- Cancel — only shown while the reservation is still Pending (see
                 bindReservationDetails); gone once Cancelled/Booked/Expired. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="end">

                <Button
                    android:id="@+id/reservationDetailsCancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:background="@drawable/bg_button_white_pill"
                    android:stateListAnimator="@null"
                    android:text="@string/button_cancel"
                    android:textAllCaps="false"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Status banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/reservationDetailsStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot_filled" />

                    <TextView
                        android:id="@+id/reservationDetailsStatusLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.04"
                        android:textAllCaps="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/reservationDetailsStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />

                <include android:id="@+id/reservationDetailsRowReference" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowAccommodation" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowDate" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowNights" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowGuests" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowFullPayment" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowDownPayment" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Cancelled reason (STATUS_CANCELLED only) -->
            <LinearLayout
                android:id="@+id/reservationDetailsCancelledContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:visibility="gone">

                <TextView style="@style/BillingSectionLabel" android:text="@string/section_reason" />

                <TextView
                    android:id="@+id/reservationDetailsCancelledReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Expired notice (STATUS_EXPIRED only) -->
            <LinearLayout
                android:id="@+id/reservationDetailsExpiredContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:visibility="gone">

                <TextView style="@style/BillingSectionLabel" android:text="@string/section_reason" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/reservation_desc_expired"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Guest Information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_guest_information" />

                <include android:id="@+id/reservationDetailsRowFullName" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowEmail" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowMobile" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowAddress" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Reservation Timeline — a real progress indicator (see
                 HotelBookingFlowController#bindReservationTimeline), not a static status legend:
                 each stage the reservation has actually reached is filled with its date/time,
                 the current stage is bold, and stages not yet reached stay hollow/gray. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:textAllCaps="true"
                android:textColor="?attr/textOnScreen"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="@string/section_reservation_timeline" />

            <LinearLayout
                android:id="@+id/reservationDetailsTimelineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/reservationDetailsPayNowButton"
            style="@style/PrimaryButton"
            android:text="@string/button_pay_now" />
    </LinearLayout>

</LinearLayout>
