<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation Confirmed's "View Reservation" button â€” a standalone status screen for the
     reservation just submitted (reference/accommodation/date/guest, guest info, and a mock Pay
     Now, since there's no backend to actually process payment against yet). See
     HotelBookingFlowController#bindReservationDetails. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/reservationDetailsHeaderBar"
                layout="@layout/view_screen_header" />

            <!-- Cancel: shown only for an unpaid request whose status key is pending (see bindReservationDetails). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="end">

                <Button
                    android:id="@+id/reservationDetailsCancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:background="@drawable/bg_button_white_pill"
                    android:stateListAnimator="@null"
                    android:text="@string/button_cancel"
                    android:textAllCaps="false"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Status banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_browse_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/reservationDetailsStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot_filled" />

                    <TextView
                        android:id="@+id/reservationDetailsStatusLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/reservationDetailsStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />

                <include android:id="@+id/reservationDetailsRowReference" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowCreated" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowAccommodation" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowDate" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowNights" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowGuests" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowFullPayment" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowDownPayment" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowAmountPaid" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowChange" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Payment verification: the receptionist's check of the submitted payment — its status,
                 why it was rejected, and the latest amount / reference / proof on file (see
                 HotelBookingFlowController#renderPaymentVerification). Gone when there is nothing
                 to verify. -->
            <LinearLayout
                android:id="@+id/reservationDetailsVerificationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_browse_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_payment_verification" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/reservationDetailsVerificationDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot_filled" />

                    <TextView
                        android:id="@+id/reservationDetailsVerificationStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/reservationDetailsVerificationMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/reservationDetailsVerificationRemarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp" />

                <include android:id="@+id/reservationDetailsVerificationAmount" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsVerificationReference" layout="@layout/view_hotel_label_value_row" />

                <TextView
                    android:id="@+id/reservationDetailsVerificationProofLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.04"
                    android:textAllCaps="true"
                    android:textColor="?attr/textMuted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="@string/label_proof_of_payment" />

                <ImageView
                    android:id="@+id/reservationDetailsVerificationProof"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_upload_dropzone"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Who cancelled and why (shown only when the record's status key is cancelled) -->
            <LinearLayout
                android:id="@+id/reservationDetailsCancelledContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_browse_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                android:padding="16dp"
                android:visibility="gone">

                <TextView style="@style/BillingSectionLabel" android:text="@string/section_reason" />

                <TextView
                    android:id="@+id/reservationDetailsCancelledReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Guest Information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_browse_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_guest_information" />

                <include android:id="@+id/reservationDetailsRowFullName" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowEmail" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowMobile" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/reservationDetailsRowAddress" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Booking progress: the booking statuses in the backend's order (GET /booking/statuses),
                 filled up to the booking's current status (see
                 HotelBookingFlowController#bindReservationTimeline). Hidden for a request. -->
            <TextView
                android:id="@+id/reservationDetailsTimelineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:textAllCaps="true"
                android:textColor="?attr/textOnScreen"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="@string/section_booking_progress" />

            <LinearLayout
                android:id="@+id/reservationDetailsTimelineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Shown only while the booking's payment is rejected and waiting for the guest's correction. -->
        <Button
            android:id="@+id/reservationDetailsCorrectPaymentButton"
            style="@style/PrimaryButton"
            android:text="@string/button_correct_resubmit"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/reservationDetailsPayNowButton"
            style="@style/PrimaryButton"
            android:text="@string/button_pay_now" />
    </LinearLayout>

</LinearLayout>

