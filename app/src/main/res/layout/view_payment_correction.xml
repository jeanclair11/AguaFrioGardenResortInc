<?xml version="1.0" encoding="utf-8"?>
<!-- "Correct & Resubmit": the guest fixes the amount, reference number and/or proof of payment of a
     payment the receptionist rejected, on the same booking. See
     HotelBookingFlowController#bindPaymentCorrection. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/paymentCorrectionHeaderBar"
                layout="@layout/view_screen_header" />

            <!-- Why it was rejected: first thing the guest reads. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:background="@drawable/bg_browse_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                android:padding="16dp">

                <TextView
                    android:id="@+id/paymentCorrectionRejectedTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_rejected_title"
                    android:textColor="?attr/errorText"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/paymentCorrectionRejectedMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/paymentCorrectionRejectedRemarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/textMuted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/paymentCorrectionSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/payment_correction_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <!-- The booking, unchanged, and what was submitted the first time. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_browse_card"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_original_submission" />

                <include android:id="@+id/paymentCorrectionRowReference" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/paymentCorrectionRowTotal" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/paymentCorrectionRowOriginalAmount" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/paymentCorrectionRowOriginalReference" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Corrected details -->
            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.04"
                android:textAllCaps="true"
                android:textColor="?attr/textOnScreen"
                android:text="@string/section_corrected_details" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="14dp"
                android:text="@string/label_amount_paid" />

            <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
                <EditText
                    android:id="@+id/paymentCorrectionAmountField"
                    style="@style/AuthInputEditText"
                    android:hint="@string/hint_amount_paid"
                    android:inputType="numberDecimal" />
            </com.aguafriogarden.resortinc.AuthInputField>

            <TextView
                android:id="@+id/paymentCorrectionAmountFlag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/payment_flagged"
                android:textColor="?attr/errorText"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_reference_number" />

            <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
                <EditText
                    android:id="@+id/paymentCorrectionReferenceField"
                    style="@style/AuthInputEditText"
                    android:hint="@string/hint_reference_number"
                    android:inputType="number" />
            </com.aguafriogarden.resortinc.AuthInputField>

            <TextView
                android:id="@+id/paymentCorrectionReferenceFlag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/payment_flagged"
                android:textColor="?attr/errorText"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="20dp"
                android:text="@string/section_payment_screenshot" />

            <!-- The screenshot on file (or the new one), or the empty drop zone once removed. -->
            <FrameLayout
                android:id="@+id/paymentCorrectionProofDropzone"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_upload_dropzone"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/paymentCorrectionProofHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_upload"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/upload_payment_screenshot"
                        android:textColor="?attr/textMuted"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/paymentCorrectionProofPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/paymentCorrectionProofFlag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/payment_flagged"
                android:textColor="?attr/errorText"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/paymentCorrectionProofCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/paymentCorrectionProofRemove"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="@string/payment_proof_remove"
                    android:textColor="?attr/errorText"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/helper_payment_screenshot"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/paymentCorrectionResubmitButton"
            style="@style/PrimaryButton"
            android:text="@string/button_resubmit_payment"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
