<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up step 3: valid ID type + photo, optional profile picture,
     terms, and the final Create Account action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/signup_heading"
        android:textColor="?attr/textPrimary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/signup_step3_subheading"
        android:textColor="?attr/textMuted"
        android:textSize="13sp" />

    <!-- Valid ID Type -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="22dp"
        android:text="@string/label_id_type" />

    <LinearLayout
        style="@style/InputField"
        android:paddingEnd="4dp">

        <Spinner
            android:id="@+id/idTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <TextView
        android:id="@+id/idTypeError"
        style="@style/FieldError" />

    <!-- Upload Valid ID -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="20dp"
        android:text="@string/label_upload_valid_id" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/uploadGovIdButton"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/accentPrimary"
            android:text="@string/button_upload" />

        <Button
            android:id="@+id/captureGovIdButton"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="?attr/accentPrimary"
            android:text="@string/button_use_camera" />
    </LinearLayout>

    <ImageView
        android:id="@+id/govIdPreview"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@string/label_upload_valid_id" />

    <TextView
        android:id="@+id/govIdError"
        style="@style/FieldError" />

    <!-- Profile Picture (optional) -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="20dp"
        android:text="@string/label_profile_picture" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/profilePreview"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_input"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            android:contentDescription="@string/label_profile_picture" />

        <Button
            android:id="@+id/uploadProfileButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_upload"
            android:textAllCaps="false"
            android:textColor="?attr/accentPrimary" />
    </LinearLayout>

    <!-- Terms and Conditions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="top"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/termsCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <TextView
            android:id="@+id/termsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:lineSpacingExtra="1dp"
            android:text="@string/terms_and_conditions"
            android:textColor="?attr/textMuted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/termsError"
        style="@style/FieldError" />

    <!-- Back / Create Account -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/signUp3BackButton"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/button_back" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <Button
                android:id="@+id/createAccountButton"
                style="@style/PrimaryButton"
                android:enabled="false"
                android:textSize="13sp"
                android:text="@string/create_account" />

            <ProgressBar
                android:id="@+id/createAccountProgress"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:indeterminateTint="?attr/onPrimaryButton"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
