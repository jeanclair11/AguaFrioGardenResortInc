<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation Module, screen 4: guest contact details, auto-populated
     where available and always editable. See
     ReservationFlowController#bindGuestInfo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/reservationGuestInfoHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="18dp"
                android:text="@string/reservation_guest_info_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <TextView style="@style/FieldLabelOnScreen" android:text="@string/label_full_name" />
            <LinearLayout style="@style/InputField">
                <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />
                <EditText
                    android:id="@+id/guestInfoNameField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_full_name"
                    android:inputType="textPersonName" />
            </LinearLayout>
            <TextView android:id="@+id/guestInfoNameError" style="@style/FieldError" />

            <TextView style="@style/FieldLabelOnScreen" android:layout_marginTop="16dp" android:text="@string/label_email_address" />
            <LinearLayout style="@style/InputField">
                <ImageView style="@style/InputIcon" android:src="@drawable/ic_email" />
                <EditText
                    android:id="@+id/guestInfoEmailField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress" />
            </LinearLayout>
            <TextView android:id="@+id/guestInfoEmailError" style="@style/FieldError" />

            <TextView style="@style/FieldLabelOnScreen" android:layout_marginTop="16dp" android:text="@string/label_mobile_number" />
            <LinearLayout style="@style/InputField">
                <ImageView style="@style/InputIcon" android:src="@drawable/ic_phone" />
                <EditText
                    android:id="@+id/guestInfoMobileField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_guest_mobile"
                    android:inputType="phone" />
            </LinearLayout>
            <TextView android:id="@+id/guestInfoMobileError" style="@style/FieldError" />

            <TextView style="@style/FieldLabelOnScreen" android:layout_marginTop="16dp" android:text="@string/label_address" />
            <LinearLayout style="@style/InputField">
                <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />
                <EditText
                    android:id="@+id/guestInfoAddressField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_guest_address"
                    android:inputType="textPostalAddress" />
            </LinearLayout>
            <TextView android:id="@+id/guestInfoAddressError" style="@style/FieldError" />

            <TextView style="@style/FieldLabelOnScreen" android:layout_marginTop="16dp" android:text="@string/label_purpose_of_reservation" />
            <LinearLayout style="@style/InputField">
                <EditText
                    android:id="@+id/guestInfoPurposeField"
                    style="@style/InputEditText"
                    android:hint="@string/hint_optional" />
            </LinearLayout>

            <TextView style="@style/FieldLabelOnScreen" android:layout_marginTop="16dp" android:text="@string/label_special_request" />
            <EditText
                android:id="@+id/guestInfoSpecialRequestField"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/hint_special_request"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="?attr/textPrimary"
                android:textColorHint="?attr/textHint"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/reservationGuestInfoNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />
    </LinearLayout>

</LinearLayout>
