<?xml version="1.0" encoding="utf-8"?>
<!-- Wizard step 1: check-in/out dates and party size. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="0dp"
            android:text="@string/label_check_in" />

        <LinearLayout style="@style/InputField">

            <ImageView style="@style/InputIcon" android:src="@drawable/ic_calendar" />

            <EditText
                android:id="@+id/checkInField"
                style="@style/InputEditText"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/hint_select_date" />
        </LinearLayout>

        <TextView
            android:id="@+id/checkInError"
            style="@style/FieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_check_out" />

        <LinearLayout style="@style/InputField">

            <ImageView style="@style/InputIcon" android:src="@drawable/ic_calendar" />

            <EditText
                android:id="@+id/checkOutField"
                style="@style/InputEditText"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/hint_select_date" />
        </LinearLayout>

        <TextView
            android:id="@+id/checkOutError"
            style="@style/FieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_adults" />

        <LinearLayout
            style="@style/InputField"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/adultsMinus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_minus"
                android:background="@drawable/bg_stepper_button" />

            <TextView
                android:id="@+id/adultsValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1"
                android:textColor="?attr/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/adultsPlus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_plus"
                android:background="@drawable/bg_stepper_button" />
        </LinearLayout>

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_children" />

        <LinearLayout
            style="@style/InputField"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/childrenMinus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_minus"
                android:background="@drawable/bg_stepper_button" />

            <TextView
                android:id="@+id/childrenValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="?attr/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/childrenPlus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_plus"
                android:background="@drawable/bg_stepper_button" />
        </LinearLayout>

        <Button
            android:id="@+id/step1ProceedButton"
            style="@style/PrimaryButton"
            android:layout_marginTop="28dp"
            android:text="@string/button_proceed" />

    </LinearLayout>
</ScrollView>
