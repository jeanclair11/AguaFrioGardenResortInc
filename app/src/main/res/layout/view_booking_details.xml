<?xml version="1.0" encoding="utf-8"?>
<!-- Full Booking Details screen, reached from a Home booking progress card.
     See DashboardHomeController#bindDetails. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <include
                android:id="@+id/detailsHeaderBar"
                layout="@layout/view_screen_header" />

            <!-- Status / progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_booking_status" />

                <TextView
                    android:id="@+id/detailsItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailsCurrentStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailsDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/textMuted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/detailsProgressList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

                <include
                    android:id="@+id/detailsRowCancelledOn"
                    layout="@layout/view_hotel_label_value_row"
                    android:visibility="gone" />

                <include
                    android:id="@+id/detailsRowCancelledReason"
                    layout="@layout/view_hotel_label_value_row"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Accommodation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_accommodation" />

                <include android:id="@+id/detailsRowAccommodationType" layout="@layout/view_hotel_label_value_row" />

                <!-- Room Type is the primary heading; Category is secondary
                     context below it. See DashboardHomeController#showDetails. -->
                <TextView
                    android:id="@+id/detailsPrimaryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="?attr/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailsSecondaryInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/textMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Booking reference -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_booking_reference" />

                <TextView
                    android:id="@+id/detailsBookingReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.03"
                    android:textColor="?attr/textPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Guest information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_guest_information" />

                <include android:id="@+id/detailsRowFullName" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/detailsRowEmail" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/detailsRowMobile" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Schedule -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_stay_details" />

                <include android:id="@+id/detailsRowCheckIn" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/detailsRowCheckOut" layout="@layout/view_hotel_label_value_row" />
                <include android:id="@+id/detailsRowGuests" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

            <!-- Selected services -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_selected_services" />

                <LinearLayout
                    android:id="@+id/detailsServicesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Charges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_charges" />

                <include android:id="@+id/detailsRowSubtotal" layout="@layout/view_hotel_billing_line_row" />
                <include android:id="@+id/detailsRowAmountPaid" layout="@layout/view_hotel_billing_line_row" />
                <include android:id="@+id/detailsRowRemainingBalance" layout="@layout/view_hotel_billing_line_row" />
            </LinearLayout>

            <!-- Payment information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    style="@style/BillingSectionLabel"
                    android:text="@string/section_payment_information" />

                <include android:id="@+id/detailsRowPaymentStatus" layout="@layout/view_hotel_label_value_row" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
