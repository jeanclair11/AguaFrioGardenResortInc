<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-login landing/welcome screen: fixed header + nav tabs, then a
     scrollable marketing page (hero, gallery, about, footer). Only the
     "AGUA FRIO" nav tab is wired up; ROOMS/COTTAGES/KTV/HALLS are left as
     inert labels until their destinations exist. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenGradientEnd"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Fixed header: logo + resort name, Log In shortcut (or bell/profile once logged
             in). Visible on Home/browse tabs; fully hidden elsewhere once logged in — see
             LandingActivity#setNavBarPresent. -->
    <LinearLayout
        android:id="@+id/landingHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_top_bar_gradient">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/agua_frio_logo"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:text="@string/resort_title"
                android:textColor="?attr/onTopBar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="@string/resort_subtitle"
                android:textColor="?attr/accentPrimary"
                android:textSize="8sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/landingLogInButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/log_in"
            android:textColor="?attr/onTopBar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <!-- Shown instead of Log In once a guest is logged in. -->
        <FrameLayout
            android:id="@+id/landingBellCluster"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/bellButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:src="@drawable/ic_bell"
                android:tint="?attr/onTopBar"
                android:contentDescription="@string/open_notifications" />

            <TextView
                android:id="@+id/bellBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:minWidth="16dp"
                android:background="@drawable/bg_badge_count"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <ImageView
            android:id="@+id/profileButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            android:tint="?attr/onTopBar"
            android:contentDescription="@string/profile"
            android:visibility="gone" />

    </LinearLayout>

    <!-- landingContentContainer + landingNavBar are overlaid siblings (not stacked in
         the normal vertical flow) so the nav bar can hide/show via translationY alone
         — a pure transform, no layout pass — letting it respond to scroll direction
         immediately instead of fighting an active touch-scroll with a relayout. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <com.aguafriogarden.resortinc.SwipeNavigationContainer
        android:id="@+id/landingContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true">

    <ScrollView
        android:id="@+id/landingHomeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Hero card (logged out) vs Greeting+Progress (logged in, see
                 view_dashboard_home.xml) — LandingActivity swaps this slot's single child
                 based on login state; everything below (Intro/Gallery/About/Footer) stays
                 the same either way. -->
            <FrameLayout
                android:id="@+id/heroOrGreetingSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/heroSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card"
                android:paddingTop="28dp"
                android:paddingBottom="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:src="@drawable/agua_frio_logo"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/landing_welcome_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_welcome_subtitle"
                    android:textColor="?attr/accentPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            </FrameLayout>

            <!-- Intro card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/landing_intro_paragraph"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Gallery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_camera"
                    android:tint="?attr/textOnScreen"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_gallery_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/landingGalleryScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <!-- Three back-to-back copies of the same 5 images (see
                     LandingActivity#setupInfiniteGallery) — the gallery silently jumps by one
                     copy-width whenever scroll strays into copy A or C, so as far as the guest
                     can tell it just loops forever in either direction. No androidx dependency
                     (ViewPager2/RecyclerView) needed for this since the project stays on plain
                     framework widgets throughout. -->
                <LinearLayout
                    android:id="@+id/landingGalleryContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp">

                    <!-- Copy A -->
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_light_mode" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_light_mode2" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_frio_bgimg" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_night_mode" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_night_mode2" />
                    </FrameLayout>

                    <!-- Copy B (the guest starts here, see setupInfiniteGallery) -->
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_light_mode" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_light_mode2" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_frio_bgimg" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_night_mode" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_night_mode2" />
                    </FrameLayout>

                    <!-- Copy C -->
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_light_mode" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_light_mode2" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_frio_bgimg" />
                    </FrameLayout>
                    <FrameLayout style="@style/LandingGalleryTile">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_night_mode" />
                    </FrameLayout>
                    <FrameLayout
                        style="@style/LandingGalleryTile"
                        android:layout_marginEnd="0dp">
                        <ImageView style="@style/LandingGalleryTilePhoto" android:src="@drawable/agua_night_mode2" />
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- About the Resort -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="30dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="24dp"
                    android:background="?attr/dividerColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_about_resort_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/landing_about_resort_body"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_about_owners_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/landing_about_owners_body"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Share the App -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="30dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="24dp"
                    android:background="?attr/dividerColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_share_app_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/landing_share_app_body"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_qr_container"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/shareAppQrPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/dividerColor"
                        android:gravity="center"
                        android:text="@string/label_qr_code_placeholder"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_scan_to_download"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/shareAppButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:background="@drawable/bg_button_outline_accent"
                    android:text="@string/button_share_app"
                    android:textColor="?attr/accentPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="26dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="?attr/dividerColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/landing_footer_line1"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/landing_footer_line2"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    </com.aguafriogarden.resortinc.SwipeNavigationContainer>

    <!-- Section nav tabs: drawn after landingContentContainer so it overlays on top. -->
    <HorizontalScrollView
        android:id="@+id/landingNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="6dp"
        android:background="?attr/surfaceRaised"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/navTabHome"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_home" />

            <TextView
                android:id="@+id/navTabRooms"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_rooms" />

            <TextView
                android:id="@+id/navTabCottages"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_cottages" />

            <TextView
                android:id="@+id/navTabKtv"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_ktv" />

            <TextView
                android:id="@+id/navTabHalls"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_halls" />

        </LinearLayout>
    </HorizontalScrollView>

    </FrameLayout>

    <!-- Reserve/Book/Chat/Feedback bottom nav — only shown once logged in. -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dividerColor"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="?attr/navBarBackground"
        android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
