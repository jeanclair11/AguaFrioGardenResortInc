<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-login landing/welcome screen: fixed header + nav tabs, then a
     scrollable marketing page (hero, gallery, about, footer). Only the
     "AGUA FRIO" nav tab is wired up; ROOMS/COTTAGES/KTV/HALLS are left as
     inert labels until their destinations exist. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_screen_gradient">

    <!-- Fixed header: logo + resort name, Log In shortcut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_top_bar_gradient">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/agua_frio_logo"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:text="@string/resort_title"
                android:textColor="?attr/onTopBar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="@string/resort_subtitle"
                android:textColor="?attr/accentPrimary"
                android:textSize="8sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/landingLogInButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/log_in"
            android:textColor="?attr/onTopBar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

    </LinearLayout>

    <!-- Section nav tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/surfaceRaised"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/navTabHome"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_home" />

            <TextView
                android:id="@+id/navTabRooms"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_rooms" />

            <TextView
                android:id="@+id/navTabCottages"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_cottages" />

            <TextView
                android:id="@+id/navTabKtv"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_ktv" />

            <TextView
                android:id="@+id/navTabHalls"
                style="@style/LandingNavTab"
                android:text="@string/landing_nav_halls" />

        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/landingScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Hero -->
            <LinearLayout
                android:id="@+id/heroSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="28dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:background="@drawable/bg_logo_circle"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/agua_frio_logo"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/landing_welcome_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_welcome_subtitle"
                    android:textColor="?attr/accentPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Intro card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/landing_intro_paragraph"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Gallery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_camera"
                    android:tint="?attr/textOnScreen"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_gallery_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp">

                    <FrameLayout style="@style/LandingGalleryTile" android:backgroundTint="@color/catalog_tile_hotel">
                        <ImageView style="@style/LandingGalleryTileIcon" android:src="@drawable/ic_bed" />
                    </FrameLayout>

                    <FrameLayout style="@style/LandingGalleryTile" android:backgroundTint="@color/catalog_tile_pool">
                        <ImageView style="@style/LandingGalleryTileIcon" android:src="@drawable/ic_pool" />
                    </FrameLayout>

                    <FrameLayout style="@style/LandingGalleryTile" android:backgroundTint="@color/catalog_tile_ktv">
                        <ImageView style="@style/LandingGalleryTileIcon" android:src="@drawable/ic_mic" />
                    </FrameLayout>

                    <FrameLayout style="@style/LandingGalleryTile" android:backgroundTint="@color/catalog_tile_halls">
                        <ImageView style="@style/LandingGalleryTileIcon" android:src="@drawable/ic_hall" />
                    </FrameLayout>

                    <FrameLayout
                        style="@style/LandingGalleryTile"
                        android:layout_marginEnd="0dp"
                        android:backgroundTint="@color/catalog_tile_hotel">
                        <ImageView style="@style/LandingGalleryTileIcon" android:src="@drawable/ic_location" />
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- About the Resort -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="30dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="24dp"
                    android:background="?attr/dividerColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_about_resort_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/landing_about_resort_body"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:letterSpacing="0.04"
                    android:text="@string/landing_about_owners_title"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/landing_about_owners_body"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="26dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="?attr/dividerColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/landing_footer_line1"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/landing_footer_line2"
                    android:textColor="?attr/textOnScreenMuted"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
