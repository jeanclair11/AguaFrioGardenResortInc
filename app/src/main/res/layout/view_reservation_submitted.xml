<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation Module, screen 6: submission confirmation. Deliberately says
     "Reservation Request Submitted" / PENDING, never "Confirmed" — the
     receptionist still has to review it. See
     ReservationFlowController#bindSubmitted. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_module_icon_circle">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/reservation_submitted_title"
            android:textColor="?attr/textOnScreen"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/reservation_submitted_message"
            android:textColor="?attr/textOnScreenMuted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <include android:id="@+id/submittedRowReference" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/submittedRowAccommodation" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/submittedRowDate" layout="@layout/view_hotel_label_value_row" />
            <include android:id="@+id/submittedRowGuests" layout="@layout/view_hotel_label_value_row" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/submittedStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_progress_dot_filled" />

                <TextView
                    android:id="@+id/submittedStatusLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.04"
                    android:textAllCaps="true"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/message_pending_wait"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView style="@style/BillingSectionLabel" android:text="@string/section_what_happens_next" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/what_happens_next_message"
                android:textColor="?attr/textMuted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/outcome_confirmed"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/outcome_additional_confirmation"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/outcome_rejected"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/outcome_cancelled"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/submittedViewButton"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:text="@string/button_view_my_reservation" />

    </LinearLayout>
</ScrollView>
