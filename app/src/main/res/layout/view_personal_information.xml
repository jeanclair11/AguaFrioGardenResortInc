<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <include
            android:id="@+id/headerBar"
            layout="@layout/view_screen_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/personal_info_subheading"
            android:textColor="?attr/textOnScreenMuted"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.06"
            android:textColor="?attr/accentPrimary"
            android:text="@string/section_personal_details" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:text="@string/label_first_name" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />
            <EditText
                android:id="@+id/piFirstNameField"
                style="@style/AuthInputEditText"
                android:inputType="textPersonName" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piFirstNameError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_middle_name" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />
            <EditText
                android:id="@+id/piMiddleNameField"
                style="@style/AuthInputEditText"
                android:inputType="textPersonName" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piMiddleNameError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_last_name" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />
            <EditText
                android:id="@+id/piLastNameField"
                style="@style/AuthInputEditText"
                android:inputType="textPersonName" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piLastNameError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_gender" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <Spinner
                android:id="@+id/piGenderSpinner"
                style="@style/AuthSpinner" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piGenderError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_birth_date" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_calendar" />
            <EditText
                android:id="@+id/piBirthDateField"
                style="@style/AuthInputEditText"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/hint_select_date" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piBirthDateError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_phone" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_phone" />
            <EditText
                android:id="@+id/piPhoneNumberField"
                style="@style/AuthInputEditText"
                android:hint="@string/hint_phone"
                android:inputType="phone" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piPhoneNumberError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:textColor="?attr/accentPrimary"
            android:text="@string/section_home_address" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:text="@string/label_province" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />
            <EditText
                android:id="@+id/piProvinceField"
                style="@style/AuthInputEditText"
                android:hint="@string/hint_province" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piProvinceError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_city" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />
            <EditText
                android:id="@+id/piCityField"
                style="@style/AuthInputEditText"
                android:hint="@string/hint_city" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piCityError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_barangay" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />
            <EditText
                android:id="@+id/piBarangayField"
                style="@style/AuthInputEditText"
                android:hint="@string/hint_barangay" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piBarangayError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:textColor="?attr/accentPrimary"
            android:text="@string/section_account_information" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:text="@string/label_username" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_person" />
            <EditText
                android:id="@+id/piUsernameField"
                style="@style/AuthInputEditText"
                android:hint="@string/hint_username" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piUsernameError" style="@style/AuthFieldError" />

        <TextView
            style="@style/FieldLabelOnScreen"
            android:layout_marginTop="16dp"
            android:text="@string/label_email" />

        <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">
            <ImageView style="@style/InputIcon" android:src="@drawable/ic_email" />
            <EditText
                android:id="@+id/piEmailField"
                style="@style/AuthInputEditText"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />
        </com.aguafriogarden.resortinc.AuthInputField>
        <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/piEmailError" style="@style/AuthFieldError" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="28dp">

            <Button
                android:id="@+id/piCancelButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/button_cancel" />

            <Button
                android:id="@+id/piChangeButton"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/button_change" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
