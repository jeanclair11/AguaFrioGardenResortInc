<?xml version="1.0" encoding="utf-8"?>
<!-- Hotel booking flow, KTV Overview entry only: a focused "Plan Your KTV Session" gate screen
     (rate type, date, start time, read-only end time/duration, guest count, Next) shown only
     when "Book Now" is tapped from the Room/Cottage/KTV Overview screen
     (LandingActivity#showRoomOverview) for a KTV room specifically — deliberately distinct from
     the hotel-room (view_room_booking_dates.xml) and cottage (view_cottage_booking_dates.xml)
     gate screens, and from the Book tab's own tabbed dates+search screen (view_hotel_dates.xml).
     See HotelBookingFlowController#bindKtvDatesEntry. Tapping Next feeds the same
     ktvRateType/ktvDateMillis/ktvStartHour/ktvStartMinute/ktvGuestCount fields the tabbed
     screen's KTV tab uses, then reveals that screen's already-loaded KTV catalog — reusing its
     browse/select logic rather than duplicating it here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/ktvDatesHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/ktv_dates_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <!-- Rate Type -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="22dp"
                android:text="@string/label_rate_type" />

            <RadioGroup
                android:id="@+id/ktvDatesRateTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/ktvDatesRateRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/accentPrimary"
                    android:text="@string/ktv_rate_type_regular"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/ktvDatesRateConsumable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="?attr/accentPrimary"
                    android:text="@string/ktv_rate_type_consumable"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp" />

            </RadioGroup>
            <TextView android:id="@+id/ktvDatesRateTypeError" style="@style/FieldError" />

            <!-- Date -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_date" />

            <LinearLayout
                android:id="@+id/ktvDatesDateField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_selector"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_calendar"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/ktvDatesDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/hint_select_date"
                    android:textColor="?attr/textPrimary"
                    android:alpha="0.5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    android:importantForAccessibility="no" />

            </LinearLayout>
            <TextView android:id="@+id/ktvDatesDateError" style="@style/FieldError" />

            <!-- Start Time -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_start_time" />

            <LinearLayout
                android:id="@+id/ktvDatesStartTimeField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_selector"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_clock"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/ktvDatesStartTimeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/hint_select_time"
                    android:textColor="?attr/textPrimary"
                    android:alpha="0.5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    android:importantForAccessibility="no" />

            </LinearLayout>
            <TextView android:id="@+id/ktvDatesStartTimeError" style="@style/FieldError" />

            <!-- End Time (read-only, computed from rate type + start time) -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_end_time" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_selector"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/ktvDatesEndTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/placeholder_em_dash"
                    android:textColor="?attr/textPrimary"
                    android:alpha="0.5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Duration (read-only, computed) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_duration"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/ktvDatesDurationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_em_dash"
                    android:textColor="?attr/textMuted"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Guest Count -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_guest_count" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_selector"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_guest_count"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ktvDatesGuestCountMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/bg_stepper_button" />

                <EditText
                    android:id="@+id/ktvDatesGuestCountValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:inputType="number"
                    android:maxLength="2"
                    android:selectAllOnFocus="true"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/ktvDatesGuestCountPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/bg_stepper_button" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/ktvDatesNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />

    </LinearLayout>

</LinearLayout>
