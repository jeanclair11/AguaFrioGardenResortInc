<?xml version="1.0" encoding="utf-8"?>
<!-- Hotel booking flow's own focused "Plan Your KTV Session" gate screen (rate type, date, start
     time, read-only end time/duration, guest count, Next) for KTV Rooms — the Book/Reserve tabs'
     shared entry point, reached either from their "What do you want to book/reserve?" picker or
     from a KTV Overview's "Book Now"/"Reserve Now" — deliberately distinct from the hotel-room
     (view_room_booking_dates.xml) and cottage (view_cottage_booking_dates.xml) gate screens. See
     HotelBookingFlowController#bindKtvDatesEntry. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/ktvDatesHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/ktv_dates_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <!-- Date -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_date" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:id="@+id/ktvDatesDateField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_calendar"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/ktvDatesDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/hint_select_date"
                    android:textColor="?attr/textPrimary"
                    android:alpha="0.5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    android:importantForAccessibility="no" />

            </com.aguafriogarden.resortinc.AuthInputField>
            <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/ktvDatesDateError" style="@style/AuthFieldError" />

            <!-- Start Time -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_start_time" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:id="@+id/ktvDatesStartTimeField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_clock"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/ktvDatesStartTimeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/hint_select_time"
                    android:textColor="?attr/textPrimary"
                    android:alpha="0.5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    android:importantForAccessibility="no" />

            </com.aguafriogarden.resortinc.AuthInputField>
            <com.aguafriogarden.resortinc.AuthFieldError android:id="@+id/ktvDatesStartTimeError" style="@style/AuthFieldError" />

            <!-- End Time (read-only, start time + chosen duration) -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_end_time" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/ktvDatesEndTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/placeholder_em_dash"
                    android:textColor="?attr/textPrimary"
                    android:alpha="0.5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </com.aguafriogarden.resortinc.AuthInputField>

            <!-- Duration: read-only. The length comes from the price packages configured in KTV Room
                 Management (see HotelBookingFlowController#loadKtvSessionHours); the guest cannot
                 change it. -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_duration" />

            <com.aguafriogarden.resortinc.AuthInputField
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auth_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/ktvDatesDurationInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </com.aguafriogarden.resortinc.AuthInputField>

            <!-- The cottages / KTV rooms free for the chosen schedule, filled by
                 HotelBookingFlowController#renderFacilityList: one card per item that has availability,
                 each with its own quantity control (a KTV room is a SELECT toggle). An item with
                 nothing free is never listed. The message line stands in for the list while there is
                 no schedule yet, while loading, when nothing is free, and on a failure (with the
                 retry button). The notice only shows on a later step of a multi-facility booking,
                 where the party was already entered on the first facility. -->
            <TextView
                android:id="@+id/facilityListTitle"
                style="@style/FieldLabel"
                android:layout_marginTop="26dp" />

            <TextView
                android:id="@+id/facilityListMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/facilityListRetryButton"
                style="@style/SecondaryButton"
                android:text="@string/button_try_again"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/facilityListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <include
                android:id="@+id/facilityListCapacityNotice"
                layout="@layout/view_guest_capacity_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/ktvDatesNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />

    </LinearLayout>

</LinearLayout>
