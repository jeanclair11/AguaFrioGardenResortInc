<?xml version="1.0" encoding="utf-8"?>
<!-- One Current/Upcoming/Past shortcut (icon + count badge + label) inside the Profile page's
     My Reservations / My Bookings card — see ProfileController#bindHistoryCard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="34dp">

        <ImageView
            android:id="@+id/historyShortcutIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/historyShortcutBadge"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge_count"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="16dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/historyShortcutLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/textPrimary"
        android:textSize="13sp" />

</LinearLayout>
