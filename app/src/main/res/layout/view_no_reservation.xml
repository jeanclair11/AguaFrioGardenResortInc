<?xml version="1.0" encoding="utf-8"?>
<!-- My Reservations/My Bookings on Choose Your Stay Dates, when there's nothing to show yet
     (see HotelBookingFlowController#bindNoReservation). Title/message swap based on reserveMode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <include
        android:id="@+id/noReservationHeaderBar"
        layout="@layout/view_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="60dp">

        <TextView
            android:id="@+id/noReservationMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/textOnScreenMuted"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
