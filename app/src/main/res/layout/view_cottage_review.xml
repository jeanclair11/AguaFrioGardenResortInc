<?xml version="1.0" encoding="utf-8"?>
<!-- Cottage booking flow: Review Your Selection, reached from Your Selected Cottage/s' Next
     button. See HotelBookingFlowController#bindCottageReview. Mirrors view_hotel_review.xml's
     structure/wording, but with cottage-specific fields (rate type/date/time/guests) instead of
     check-in/check-out/nights, and no price/amenity continuation yet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/cottageReviewHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="18dp"
                android:text="@string/hotel_review_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <include
                    android:id="@+id/cottageReviewRowRateType"
                    layout="@layout/view_hotel_label_value_row"
                    android:layout_marginTop="0dp" />

                <include
                    android:id="@+id/cottageReviewRowDate"
                    layout="@layout/view_hotel_label_value_row" />

                <include
                    android:id="@+id/cottageReviewRowTime"
                    layout="@layout/view_hotel_label_value_row" />

                <include
                    android:id="@+id/cottageReviewRowTotalGuest"
                    layout="@layout/view_hotel_label_value_row" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:textAllCaps="true"
                android:textColor="?attr/textOnScreen"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="@string/section_selected_cottage" />

            <LinearLayout
                android:id="@+id/cottageReviewCottagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.04"
                android:textAllCaps="true"
                android:textColor="?attr/textOnScreen"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="@string/section_special_request" />

            <EditText
                android:id="@+id/cottageReviewSpecialRequestField"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/hint_special_request_flow"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="?attr/textPrimary"
                android:textColorHint="?attr/textHint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/helper_special_request_flow"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Reuses the Hotel Rooms Review screen's button id so bindCottageReview can hand off
             into the shared fetchAmenities() unchanged (same pattern as itemSelectionNextButton
             being shared across the Room/Cottage/KTV selection screens). -->
        <Button
            android:id="@+id/hotelReviewNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />
    </LinearLayout>

</LinearLayout>
