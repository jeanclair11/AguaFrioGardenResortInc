<?xml version="1.0" encoding="utf-8"?>
<!-- Book tab landing screen. hotelDragSheet (title/tabs/dates/guests/Search
     + a drag handle) overlays hotelResultsScrollView and can collapse
     upward, leaving only the handle, to give the results more room; drag
     the handle back down (or tap it) to reveal it again. See
     HotelBookingFlowController#bindDates / #renderAvailabilityResults for
     content binding and the panel-fraction helpers for the drag/collapse
     mechanics. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/hotelResultsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_available_accommodations"
                android:textColor="?attr/textOnScreen"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hotelResultsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_available_accommodations_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/hotelResultsSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/hotelResultsSectionIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_bed"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/hotelResultsSectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/textOnScreen"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/label_section_rooms" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_view_all"
                    android:textColor="?attr/accentPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/hotelResultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/hotelResultsLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/label_loading_accommodations"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hotelResultsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_accommodations_title"
                    android:textColor="?attr/textPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/empty_accommodations_message"
                    android:textColor="?attr/textMuted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/hotelResultsChangeDatesButton"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:minWidth="0dp"
                    android:text="@string/button_change_dates" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/hotelResultsErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/error_availability_title"
                    android:textColor="?attr/errorText"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/error_availability_message"
                    android:textColor="?attr/textMuted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/hotelResultsTryAgainButton"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:minWidth="0dp"
                    android:text="@string/button_try_again" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/hotelDragSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="?attr/surfaceCard"
        android:orientation="vertical"
        android:elevation="6dp">

        <LinearLayout
            android:id="@+id/hotelSearchPanelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hotel_dates_title"
                android:textColor="?attr/textPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/hotel_dates_subtitle"
                android:textColor="?attr/textMuted"
                android:textSize="13sp" />

            <!-- Category tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/hotelTabRooms"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tab_pill_selected"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/hotelTabRoomsIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_bed"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/hotelTabRoomsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hotel_rooms_title"
                        android:textColor="?attr/accentPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hotelTabCottagesKtv"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tab_pill_unselected"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/hotelTabCottagesKtvIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_pool"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/hotelTabCottagesKtvText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_cottages_ktv"
                        android:textColor="?attr/textOnScreenMuted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Dates -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/label_check_in" />

                    <LinearLayout
                        android:id="@+id/hotelCheckInField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_calendar"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/hotelCheckInDateText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="@string/hint_select_date"
                                android:textColor="?attr/textPrimary"
                                android:alpha="0.5"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hotelCheckInDayText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/textMuted"
                                android:textSize="11sp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_chevron_down"
                            android:importantForAccessibility="no" />

                    </LinearLayout>
                    <TextView android:id="@+id/hotelCheckInError" style="@style/FieldError" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/label_check_out" />

                    <LinearLayout
                        android:id="@+id/hotelCheckOutField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_calendar"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/hotelCheckOutDateText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="@string/hint_select_date"
                                android:textColor="?attr/textPrimary"
                                android:alpha="0.5"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hotelCheckOutDayText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/textMuted"
                                android:textSize="11sp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_chevron_down"
                            android:importantForAccessibility="no" />

                    </LinearLayout>
                    <TextView android:id="@+id/hotelCheckOutError" style="@style/FieldError" />

                </LinearLayout>

            </LinearLayout>

            <!-- Guests -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_stay_guests" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_selector"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_adults"
                        android:textColor="?attr/textPrimary"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/hotelAdultsMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_minus"
                        android:background="@drawable/bg_stepper_button" />

                    <EditText
                        android:id="@+id/hotelAdultsValue"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="?attr/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:padding="4dp"
                        android:minHeight="0dp"
                        android:inputType="number"
                        android:maxLength="2"
                        android:selectAllOnFocus="true"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/hotelAdultsPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_plus"
                        android:background="@drawable/bg_stepper_button" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_children"
                        android:textColor="?attr/textPrimary"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/hotelChildrenMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_minus"
                        android:background="@drawable/bg_stepper_button" />

                    <EditText
                        android:id="@+id/hotelChildrenValue"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="?attr/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:padding="4dp"
                        android:minHeight="0dp"
                        android:inputType="number"
                        android:maxLength="2"
                        android:selectAllOnFocus="true"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/hotelChildrenPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_plus"
                        android:background="@drawable/bg_stepper_button" />

                </LinearLayout>

            </LinearLayout>

            <!-- Search -->
            <LinearLayout
                android:id="@+id/hotelDatesNextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_primary"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_search"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/hotelDatesNextButtonText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_search"
                    android:textAllCaps="true"
                    android:textColor="@color/button_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/hotelDragHandle"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_description_drag_handle">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_drag_handle" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
