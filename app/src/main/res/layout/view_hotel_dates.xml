<?xml version="1.0" encoding="utf-8"?>
<!-- Hotel booking flow, screen 1: check-in/out dates and party size. See
     HotelBookingFlowController#bindDates. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <include
                android:id="@+id/hotelDatesHeaderBar"
                layout="@layout/view_screen_header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/hotel_dates_subtitle"
                android:textColor="?attr/textOnScreenMuted"
                android:textSize="13sp" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="22dp"
                android:text="@string/label_check_in" />

            <LinearLayout style="@style/InputField">
                <ImageView style="@style/InputIcon" android:src="@drawable/ic_calendar" />
                <EditText
                    android:id="@+id/hotelCheckInField"
                    style="@style/InputEditText"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_select_date" />
            </LinearLayout>
            <TextView android:id="@+id/hotelCheckInError" style="@style/FieldError" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_check_out" />

            <LinearLayout style="@style/InputField">
                <ImageView style="@style/InputIcon" android:src="@drawable/ic_calendar" />
                <EditText
                    android:id="@+id/hotelCheckOutField"
                    style="@style/InputEditText"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_select_date" />
            </LinearLayout>
            <TextView android:id="@+id/hotelCheckOutError" style="@style/FieldError" />

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_adults" />

            <LinearLayout style="@style/InputField" android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/hotelAdultsMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/bg_stepper_button" />

                <TextView
                    android:id="@+id/hotelAdultsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/hotelAdultsPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/bg_stepper_button" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabelOnScreen"
                android:layout_marginTop="16dp"
                android:text="@string/label_children" />

            <LinearLayout style="@style/InputField" android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/hotelChildrenMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/bg_stepper_button" />

                <TextView
                    android:id="@+id/hotelChildrenValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/hotelChildrenPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/bg_stepper_button" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/hotelDatesNextButton"
            style="@style/PrimaryButton"
            android:text="@string/button_next" />
    </LinearLayout>

</LinearLayout>
