<?xml version="1.0" encoding="utf-8"?>
<!-- All Rooms screen: every active hotel room type, reached from the Home
     screen's Hotel Rooms section via "See More Rooms". Reuses the same
     compact card as the Home preview (view_home_room_card.xml). See
     DashboardHomeController#showAllRooms. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp">

    <include
        android:id="@+id/allRoomsHeaderBar"
        layout="@layout/view_screen_header" />

    <TextView
        android:id="@+id/allRoomsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/hotel_rooms_empty_state"
        android:textColor="?attr/textOnScreenMuted"
        android:textSize="13sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/allRoomsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
