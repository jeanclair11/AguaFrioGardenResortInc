<?xml version="1.0" encoding="utf-8"?>
<!-- One row on the My Reservations list (see
     HotelBookingFlowController#bindMyReservationsList). Tapping loads this reservation into
     Reservation Details via #loadReservationFromSummary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_browse_card"
    android:elevation="4dp"
    android:outlineAmbientShadowColor="@color/card_shadow_ambient"
    android:outlineSpotShadowColor="@color/card_shadow_spot"
    android:foreground="?android:attr/selectableItemBackground"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/reservationCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/reservationCardStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_progress_dot_filled" />

        <TextView
            android:id="@+id/reservationCardStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/reservationCardDates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/textOnScreenMuted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/reservationCardCreated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/textOnScreenMuted"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/reservationCardPaid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/successText"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- The receptionist's check of the payment: its status, why it was rejected, and the way to
         correct it (see ProfileController#bindPaymentVerification). Gone when there is nothing to
         verify. -->
    <LinearLayout
        android:id="@+id/reservationCardVerification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/reservationCardVerificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reservationCardVerificationReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/textMuted"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/reservationCardCorrectButton"
            style="@style/PrimaryButton"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="@string/button_correct_resubmit"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/reservationCardReference"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/textMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/reservationCardTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

