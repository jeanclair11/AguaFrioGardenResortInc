<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up step 1: personal information and home address. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:text="@string/signup_heading"
        android:textColor="?attr/textPrimary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/signup_step1_subheading"
        android:textColor="?attr/textMuted"
        android:textSize="13sp" />

    <!-- First Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="22dp"
        android:text="@string/label_first_name" />

    <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">

        <EditText
            android:id="@+id/firstNameField"
            style="@style/AuthInputEditText"
            android:hint="@string/hint_first_name"
            android:inputType="textPersonName" />
    </com.aguafriogarden.resortinc.AuthInputField>

    <com.aguafriogarden.resortinc.AuthFieldError
        android:id="@+id/firstNameError"
        style="@style/AuthFieldError" />

    <!-- Middle Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_middle_name" />

    <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">

        <EditText
            android:id="@+id/middleNameField"
            style="@style/AuthInputEditText"
            android:hint="@string/hint_middle_name"
            android:inputType="textPersonName" />
    </com.aguafriogarden.resortinc.AuthInputField>

    <com.aguafriogarden.resortinc.AuthFieldError
        android:id="@+id/middleNameError"
        style="@style/AuthFieldError" />

    <!-- Last Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_last_name" />

    <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">

        <EditText
            android:id="@+id/lastNameField"
            style="@style/AuthInputEditText"
            android:hint="@string/hint_last_name"
            android:inputType="textPersonName" />
    </com.aguafriogarden.resortinc.AuthInputField>

    <com.aguafriogarden.resortinc.AuthFieldError
        android:id="@+id/lastNameError"
        style="@style/AuthFieldError" />

    <!-- Gender and Birth Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_gender" />

            <com.aguafriogarden.resortinc.AuthInputField
                style="@style/AuthInputField"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <Spinner
                    android:id="@+id/genderSpinner"
                    style="@style/AuthSpinner"
                    android:paddingEnd="22dp" />
            </com.aguafriogarden.resortinc.AuthInputField>

            <com.aguafriogarden.resortinc.AuthFieldError
                android:id="@+id/genderError"
                style="@style/AuthFieldError" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_birth_date" />

            <com.aguafriogarden.resortinc.AuthInputField
                style="@style/AuthInputField"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <EditText
                    android:id="@+id/birthDateField"
                    style="@style/AuthInputEditText"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_birth_date" />
            </com.aguafriogarden.resortinc.AuthInputField>

            <com.aguafriogarden.resortinc.AuthFieldError
                android:id="@+id/birthDateError"
                style="@style/AuthFieldError" />
        </LinearLayout>
    </LinearLayout>

    <!-- Phone Number -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_phone" />

    <com.aguafriogarden.resortinc.AuthInputField style="@style/AuthInputField">

        <EditText
            android:id="@+id/phoneNumberField"
            style="@style/AuthInputEditText"
            android:hint="@string/hint_phone"
            android:inputType="phone" />
    </com.aguafriogarden.resortinc.AuthInputField>

    <com.aguafriogarden.resortinc.AuthFieldError
        android:id="@+id/phoneNumberError"
        style="@style/AuthFieldError" />

    <!-- Home Address -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="20dp"
        android:text="@string/label_home_address"
        android:textSize="15sp" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="12dp"
        android:text="@string/label_province" />

    <com.aguafriogarden.resortinc.AuthInputField
        style="@style/AuthInputField">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />

        <Spinner
            android:id="@+id/provinceSpinner"
            style="@style/AuthSpinner" />
    </com.aguafriogarden.resortinc.AuthInputField>

    <com.aguafriogarden.resortinc.AuthFieldError
        android:id="@+id/provinceError"
        style="@style/AuthFieldError" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_city" />

    <com.aguafriogarden.resortinc.AuthInputField
        style="@style/AuthInputField">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />

        <Spinner
            android:id="@+id/citySpinner"
            style="@style/AuthSpinner" />
    </com.aguafriogarden.resortinc.AuthInputField>

    <com.aguafriogarden.resortinc.AuthFieldError
        android:id="@+id/cityError"
        style="@style/AuthFieldError" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_barangay" />

    <com.aguafriogarden.resortinc.AuthInputField
        style="@style/AuthInputField">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />

        <Spinner
            android:id="@+id/barangaySpinner"
            style="@style/AuthSpinner" />
    </com.aguafriogarden.resortinc.AuthInputField>

    <com.aguafriogarden.resortinc.AuthFieldError
        android:id="@+id/barangayError"
        style="@style/AuthFieldError" />

    <!-- Back (to login) / Proceed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/signUp1BackButton"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/button_back" />

        <Button
            android:id="@+id/signUp1ProceedButton"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/button_proceed" />
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/have_account_prompt"
            android:textColor="?attr/textMuted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/goToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="4dp"
            android:text="@string/log_in_link"
            android:textColor="?attr/accentPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
