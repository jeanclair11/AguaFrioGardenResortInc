<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up step 1: personal information and home address. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/signup_heading"
        android:textColor="?attr/textPrimary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/signup_step1_subheading"
        android:textColor="?attr/textMuted"
        android:textSize="13sp" />

    <!-- First Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="22dp"
        android:text="@string/label_first_name" />

    <LinearLayout style="@style/InputField">

        <EditText
            android:id="@+id/firstNameField"
            style="@style/InputEditText"
            android:hint="@string/hint_first_name"
            android:inputType="textPersonName" />
    </LinearLayout>

    <TextView
        android:id="@+id/firstNameError"
        style="@style/FieldError" />

    <!-- Middle Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_middle_name" />

    <LinearLayout style="@style/InputField">

        <EditText
            android:id="@+id/middleNameField"
            style="@style/InputEditText"
            android:hint="@string/hint_middle_name"
            android:inputType="textPersonName" />
    </LinearLayout>

    <TextView
        android:id="@+id/middleNameError"
        style="@style/FieldError" />

    <!-- Last Name -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_last_name" />

    <LinearLayout style="@style/InputField">

        <EditText
            android:id="@+id/lastNameField"
            style="@style/InputEditText"
            android:hint="@string/hint_last_name"
            android:inputType="textPersonName" />
    </LinearLayout>

    <TextView
        android:id="@+id/lastNameError"
        style="@style/FieldError" />

    <!-- Gender and Birth Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_gender" />

            <LinearLayout
                style="@style/InputField"
                android:paddingEnd="4dp">

                <Spinner
                    android:id="@+id/genderSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/genderError"
                style="@style/FieldError" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_birth_date" />

            <LinearLayout style="@style/InputField">

                <EditText
                    android:id="@+id/birthDateField"
                    style="@style/InputEditText"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_birth_date" />
            </LinearLayout>

            <TextView
                android:id="@+id/birthDateError"
                style="@style/FieldError" />
        </LinearLayout>
    </LinearLayout>

    <!-- Phone Number -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_phone" />

    <LinearLayout style="@style/InputField">

        <EditText
            android:id="@+id/phoneNumberField"
            style="@style/InputEditText"
            android:hint="@string/hint_phone"
            android:inputType="phone" />
    </LinearLayout>

    <TextView
        android:id="@+id/phoneNumberError"
        style="@style/FieldError" />

    <!-- Home Address -->
    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="20dp"
        android:text="@string/label_home_address"
        android:textSize="15sp" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="12dp"
        android:text="@string/label_province" />

    <LinearLayout
        style="@style/InputField"
        android:paddingEnd="4dp">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />

        <Spinner
            android:id="@+id/provinceSpinner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <TextView
        android:id="@+id/provinceError"
        style="@style/FieldError" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_city" />

    <LinearLayout
        style="@style/InputField"
        android:paddingEnd="4dp">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />

        <Spinner
            android:id="@+id/citySpinner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <TextView
        android:id="@+id/cityError"
        style="@style/FieldError" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="16dp"
        android:text="@string/label_barangay" />

    <LinearLayout
        style="@style/InputField"
        android:paddingEnd="4dp">

        <ImageView style="@style/InputIcon" android:src="@drawable/ic_location" />

        <Spinner
            android:id="@+id/barangaySpinner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <TextView
        android:id="@+id/barangayError"
        style="@style/FieldError" />

    <!-- Back (to login) / Proceed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/signUp1BackButton"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/button_back" />

        <Button
            android:id="@+id/signUp1ProceedButton"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/button_proceed" />
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/have_account_prompt"
            android:textColor="?attr/textMuted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/goToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="4dp"
            android:text="@string/log_in_link"
            android:textColor="?attr/accentPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
